APP_NAME="Wibu Store API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
# Inside Docker Compose use DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=wibu_store
DB_USERNAME=wibu_app
DB_PASSWORD=change_me_local_only

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:4321,localhost:4322,localhost:8000

CACHE_STORE=database
QUEUE_CONNECTION=database
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=shiphard-studio
AWS_ROOT=Dat/wibu-store
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=https://s3-nexpress-us1.vyta.io.vn
AWS_URL=https://s3-nexpress-us1.vyta.io.vn/shiphard-studio
AWS_PUBLIC_URL=https://s3-nexpress-us1.vyta.io.vn/shiphard-studio/Dat/wibu-store/public
AWS_PRIVATE_URL=https://s3-nexpress-us1.vyta.io.vn/shiphard-studio/Dat/wibu-store/private

STOREFRONT_URL=http://localhost:4321
ADMIN_URL=http://localhost:4322
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:4322

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@wibustore.vn"
MAIL_FROM_NAME="${APP_NAME}"

# ODOO CONNECTOR (outbound webhook + inbound export)
ODOO_CONNECTOR_URL=http://localhost:8090
ODOO_WEBHOOK_SECRET=your_odoo_webhook_secret_here
ODOO_SOURCE_TOKEN=your_odoo_source_token_here

# ODOO DIRECT (sale.channel API: order push + stock pull)
ODOO_URL=http://localhost:8069
ODOO_CHANNEL_KEY=your_sale_channel_api_key_here
ODOO_CHANNEL_CODE=wibu
ODOO_TIMEOUT=10

# LLM (OpenAI-compatible via 9router — never commit real key)
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=
LLM_CHAT_MODEL=ag/gemini-3.8-flash-low
LLM_IMAGE_MODEL=ag/gemini-3.1-flash-image,cf/@cf/bytedance/stable-diffusion-xl-lightning
LLM_VISION_MODEL=ag/gemini-3.8-flash-low,ocg/muse-spark-1.3-contributor
# De trong = khong gui max_tokens, dung default cua provider.
# LLM_MAX_TOKENS=
# Tao anh dung chung 1 bien: model dau tien duoc uu tien, cac model sau fallback.
# Gemini ve + ghep do (VN-only, HK geo-block); SDXL fallback ve tu chu (VN+HK).
LLM_TIMEOUT_SECONDS=60
