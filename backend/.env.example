APP_NAME="Wibu Store API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
# Inside Docker Compose use DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=wibu_store
DB_USERNAME=wibu_app
DB_PASSWORD=change_me_local_only

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:4321,localhost:4322,localhost:8000

CACHE_STORE=database
QUEUE_CONNECTION=database
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=shiphard-studio
AWS_ROOT=Dat/wibu-store
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=https://s3-nexpress-us1.vyta.io.vn
AWS_URL=https://s3-nexpress-us1.vyta.io.vn/shiphard-studio
AWS_PUBLIC_URL=https://s3-nexpress-us1.vyta.io.vn/shiphard-studio/Dat/wibu-store/public
AWS_PRIVATE_URL=https://s3-nexpress-us1.vyta.io.vn/shiphard-studio/Dat/wibu-store/private

STOREFRONT_URL=http://localhost:4321
ADMIN_URL=http://localhost:4322
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:4322

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@wibustore.vn"
MAIL_FROM_NAME="${APP_NAME}"
