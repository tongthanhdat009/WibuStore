---
interface Props {
  variant?: 'success' | 'warning' | 'danger' | 'info' | 'neutral' | 'brand' | 'yellow';
  size?: 'sm' | 'md';
  class?: string;
}

const {
  variant = 'neutral',
  size = 'md',
  class: className = '',
} = Astro.props;

const variantClasses = {
  success: 'bg-[#E7F5ED] text-[#147A4B] border border-[#147A4B]/20',
  warning: 'bg-[#FFF3DA] text-[#9A5A00] border border-[#9A5A00]/25',
  danger: 'bg-[#FDEDEC] text-[#B42318] border border-[#B42318]/20',
  info: 'bg-[#EDF3FF] text-[#1D58D8] border border-[#1D58D8]/20',
  neutral: 'bg-[#F2EFE9] text-[#534F5C] border border-[#D8D4D0]',
  brand: 'bg-[#FFF0F3] text-[#D6284F] border border-[#D6284F]/30 font-semibold',
  yellow: 'bg-[#FFD44A] text-[#17141F] border border-[#17141F] font-bold',
};

const sizeClasses = {
  sm: 'text-[11px] px-2 py-0.5 rounded-[5px]',
  md: 'text-[12px] px-2.5 py-1 rounded-[6px]',
};
---

<span class={`inline-flex items-center gap-1.5 font-medium leading-none whitespace-nowrap transition-colors ${variantClasses[variant]} ${sizeClasses[size]} ${className}`}>
  <slot />
</span>
