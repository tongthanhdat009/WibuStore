---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const pageTitle = `${title} — Wibu Store Studio Admin`;
---

<!doctype html>
<html lang="vi" class="h-full bg-[#FFFDF7]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,600&display=swap"
      rel="stylesheet"
    />

    <title>{pageTitle}</title>
  </head>
  <body class="min-h-full flex flex-col justify-center py-12 sm:px-6 lg:px-8 font-['Be_Vietnam_Pro'] text-[#17141F]">
    <div class="sm:mx-auto sm:w-full sm:max-w-md text-center">
      <a href="/" class="inline-flex items-center gap-2.5 justify-center mb-4">
        <div class="w-10 h-10 rounded-[8px] bg-[#D6284F] flex items-center justify-center text-white font-black text-[20px] comic-shadow-sm">
          W
        </div>
        <div class="text-left">
          <div class="font-['Anton'] text-[24px] tracking-wide text-[#17141F] leading-none">
            WIBU STORE
          </div>
          <div class="text-[11px] font-bold text-[#D6284F] tracking-widest uppercase">
            Collector Operations Studio
          </div>
        </div>
      </a>
      <h2 class="text-[22px] font-extrabold text-[#17141F]">
        {title}
      </h2>
      <p class="mt-1 text-[13px] text-[#534F5C]">
        Cổng thông tin quản trị và vận hành chuỗi mô hình chính hãng
      </p>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md px-4 sm:px-0">
      <div class="bg-white py-8 px-6 sm:px-10 rounded-[16px] border-2 border-[#17141F] comic-shadow">
        <slot />
      </div>

      <div class="mt-6 text-center text-[12px] text-[#6A6572] flex items-center justify-center gap-4">
        <span>Bảo mật hệ thống RBAC</span>
        <span>•</span>
        <span>Astro SSR on port 4322</span>
        <span>•</span>
        <a href="http://localhost:4321" class="text-[#3258D7] hover:underline">Về Storefront ↗</a>
      </div>
    </div>
  </body>
</html>
