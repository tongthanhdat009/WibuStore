---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import { apiGet, requireStaff } from '../../lib/api';

const { redirect } = await requireStaff(Astro);
if (redirect) return redirect;

interface Revision {
  id: number;
  page_id: number;
  version_number: number;
  status: string;
  content: unknown;
  published_at?: string | null;
  created_at: string;
}

const { data: revisions } = await apiGet<Revision[]>('/admin/pages/home/revisions', Astro);
const revs = revisions ?? [];
const published = revs.find((r) => r.status === 'published');
const publishedJson = published ? JSON.stringify(published.content, null, 2) : '';

interface HomeSection { type: string; enabled?: boolean; sort_order?: number; eyebrow?: string; headline?: string; cta_label?: string; cta_target?: string; }

const defaultSections: HomeSection[] = [
  { type: 'hero_comic', enabled: true, eyebrow: '', headline: '', cta_label: '', cta_target: '', sort_order: 1 },
  { type: 'trending', enabled: true, sort_order: 2 },
  { type: 'preorder_spotlight', enabled: true, sort_order: 3 },
  { type: 'new_arrivals', enabled: true, sort_order: 4 },
];

function asSections(value: unknown): HomeSection[] {
  if (value && typeof value === 'object' && Array.isArray((value as { sections?: unknown }).sections)) {
    return (value as { sections: HomeSection[] }).sections.filter((s) => s && typeof s.type === 'string');
  }
  return [];
}

const formSections = asSections(published?.content);
for (const d of defaultSections) {
  if (!formSections.some((s) => s.type === d.type)) formSections.push({ ...d });
}
const heroForm = formSections.find((s) => s.type === 'hero_comic') ?? defaultSections[0];
const otherSections = formSections.filter((s) => s.type !== 'hero_comic');

const sectionLabels: Record<string, string> = {
  hero_comic: 'Hero đầu trang',
  trending: 'Sản phẩm nổi bật',
  preorder_spotlight: 'Pre-order Spotlight',
  new_arrivals: 'Hàng mới về',
};
---

<AdminLayout
  title="CMS Trang chủ (Anime Pop / Comic Builder)"
  description="Quản lý các bản revision nội dung trang chủ: tạo nháp JSON, xuất bản, rollback"
  breadcrumbs={[{ label: 'Nội dung & Marketing' }, { label: 'CMS Trang chủ' }]}
>
  <div slot="actions" class="flex items-center gap-2">
    <a
      href="http://localhost:4321"
      target="_blank"
      class="inline-flex items-center gap-1.5 px-3 py-1.5 h-8 rounded-[8px] bg-white border border-[#D8D4D0] hover:bg-[#F7F5F0] text-[13px] font-bold text-[#17141F] shadow-xs"
    >
      <span>Mở Storefront Live (:4321)</span>
      <span>↗</span>
    </a>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-12 gap-6">
    <div class="xl:col-span-7 space-y-6">
      <div class="bg-white rounded-[14px] border border-[#D8D4D0] shadow-xs overflow-hidden">
        <div class="p-4 border-b border-[#D8D4D0]">
          <h2 class="text-[16px] font-bold text-[#17141F]">Lịch sử revisions trang home</h2>
          <p class="text-[12px] text-[#534F5C]">Storefront chỉ đọc bản <strong>published</strong>. Publish là nguyên tử + xóa cache.</p>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-[13px] border-collapse">
            <thead>
              <tr class="bg-[#FAF8F5] border-b border-[#D8D4D0] text-[#534F5C] text-[11px] font-bold uppercase tracking-wider">
                <th class="py-3 px-4">Bản</th>
                <th class="py-3 px-4">Trạng thái</th>
                <th class="py-3 px-4">Xuất bản lúc</th>
                <th class="py-3 px-4 text-center">Thao tác</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#F2EFE9]">
              {revs.length === 0 && (
                <tr><td colspan="4" class="py-8 text-center text-[12px] text-[#6A6572]">Chưa có revision nào. Tạo nháp đầu tiên bên phải.</td></tr>
              )}
              {revs.map((r) => (
                <tr class="hover:bg-[#FDFBF7]">
                  <td class="py-3.5 px-4 font-mono font-bold">v{r.version_number}</td>
                  <td class="py-3.5 px-4">
                    <Badge variant={r.status === 'published' ? 'success' : 'neutral'} size="sm">{r.status}</Badge>
                  </td>
                  <td class="py-3.5 px-4 text-[12px] text-[#6A6572]">{r.published_at ?? '—'}</td>
                  <td class="py-3.5 px-4 text-center">
                    {r.status !== 'published' && (
                      <button type="button" data-publish-rev={r.id} class="px-2.5 py-1 rounded-[6px] text-[12px] font-bold bg-[#17141F] text-white">Xuất bản</button>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      {published && (
        <div class="bg-white rounded-[14px] border border-[#D8D4D0] p-5 shadow-xs">
          <h2 class="text-[15px] font-bold text-[#17141F] mb-2">Nội dung đang published (JSON)</h2>
          <pre class="text-[11px] font-mono bg-[#17141F] text-[#D6F5D6] p-4 rounded-[8px] overflow-x-auto max-h-96 overflow-y-auto">{publishedJson}</pre>
        </div>
      )}
    </div>

    <div class="xl:col-span-5 space-y-6">
      <div class="bg-white rounded-[14px] border border-[#D8D4D0] p-5 shadow-xs space-y-4">
        <h2 class="text-[16px] font-bold text-[#17141F] border-b border-[#F2EFE9] pb-2">
          Hero đầu trang (slide đầu)
        </h2>
        <label class="flex items-center gap-2 text-[13px] font-bold text-[#17141F] cursor-pointer">
          <input id="hero-enabled" type="checkbox" checked={heroForm.enabled !== false} class="w-4 h-4 rounded text-[#D6284F]" />
          Hiển thị hero
        </label>
        <div class="space-y-3 text-[13px]">
          <div>
            <label for="hero-eyebrow" class="block font-bold text-[#17141F] mb-1">Nhãn badge (eyebrow)</label>
            <input id="hero-eyebrow" type="text" maxlength="120" value={heroForm.eyebrow ?? ''} placeholder="vd: LIMITED EDITION" class="w-full h-10 px-3 rounded-[8px] border border-[#D8D4D0]" />
          </div>
          <div>
            <label for="hero-headline" class="block font-bold text-[#17141F] mb-1">Tiêu đề lớn (headline)</label>
            <input id="hero-headline" type="text" maxlength="120" value={heroForm.headline ?? ''} placeholder="vd: NEW DROP: Gojo Satoru" class="w-full h-10 px-3 rounded-[8px] border border-[#D8D4D0]" />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="hero-cta-label" class="block font-bold text-[#17141F] mb-1">Chữ nút CTA</label>
              <input id="hero-cta-label" type="text" maxlength="60" value={heroForm.cta_label ?? ''} placeholder="vd: Mua ngay" class="w-full h-10 px-3 rounded-[8px] border border-[#D8D4D0]" />
            </div>
            <div>
              <label for="hero-cta-target" class="block font-bold text-[#17141F] mb-1">Link nút CTA</label>
              <input id="hero-cta-target" type="text" maxlength="255" value={heroForm.cta_target ?? ''} placeholder="vd: /products/gojo-..." class="w-full h-10 px-3 rounded-[8px] border border-[#D8D4D0]" />
            </div>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-[14px] border border-[#D8D4D0] p-5 shadow-xs space-y-3">
        <h2 class="text-[16px] font-bold text-[#17141F] border-b border-[#F2EFE9] pb-2">
          Bật / tắt & thứ tự sections
        </h2>
        {otherSections.map((s) => (
          <div data-section-row={s.type} class="flex items-center gap-3 text-[13px] border border-[#F2EFE9] rounded-[8px] px-3 py-2">
            <input data-field="enabled" type="checkbox" checked={s.enabled !== false} class="w-4 h-4 rounded text-[#D6284F] shrink-0" aria-label={`Hiển thị ${s.type}`} />
            <span class="font-bold text-[#17141F] flex-1">{sectionLabels[s.type] ?? s.type}</span>
            <label class="flex items-center gap-1.5 text-[12px] text-[#534F5C]">
              Thứ tự
              <input data-field="sort_order" type="number" min="1" max="99" value={s.sort_order ?? 99} class="w-16 h-8 px-2 rounded-[6px] border border-[#D8D4D0]" />
            </label>
          </div>
        ))}
        <p class="text-[11px] text-[#6A6572]">Tắt section nào thì khối đó ẩn khỏi trang chủ ngay sau khi xuất bản.</p>
      </div>

      <div class="bg-white rounded-[14px] border border-[#D8D4D0] p-5 shadow-xs space-y-4">
        <h2 class="text-[16px] font-bold text-[#17141F] border-b border-[#F2EFE9] pb-2">
          Lưu thay đổi
        </h2>
        <div id="cms-error" class="hidden p-3 rounded-[8px] bg-[#FFF0F3] border border-[#D6284F]/30 text-[12px] text-[#A61B3F]"></div>
        <div class="flex gap-2">
          <button id="cms-draft" type="button" class="flex-1 h-10 rounded-[8px] border border-[#D8D4D0] font-bold text-[13px] cursor-pointer">Lưu bản nháp</button>
          <button id="cms-publish" type="button" class="flex-1 h-10 rounded-[8px] bg-[#D6284F] text-white font-bold text-[13px] cursor-pointer">Lưu & Xuất bản luôn</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { mutate } from '../../lib/api';

    function fail(msg: string) {
      const el = document.getElementById('cms-error');
      if (el) {
        el.textContent = msg;
        el.classList.remove('hidden');
      } else {
        alert(msg);
      }
    }

    function val(id: string): string {
      return ((document.getElementById(id) as HTMLInputElement | null)?.value || '').trim();
    }

    async function loadBaseContent(): Promise<{ schema_version: number; sections: Record<string, unknown>[] } | null> {
      const { data, error } = await mutate<Record<string, unknown>[] | { sections?: unknown }>(
        '/admin/pages/home/revisions',
        'GET',
      );
      if (error || !data) {
        fail(error?.message || 'Không tải được revisions hiện tại.');
        return null;
      }
      const list = Array.isArray(data) ? data : [];
      const pub = list.find(
        (r): r is Record<string, unknown> & { content: { schema_version?: number; sections?: Record<string, unknown>[] } } =>
          typeof r === 'object' && r !== null && (r as { status?: unknown }).status === 'published',
      );
      const content = pub?.content;
      if (content && Array.isArray(content.sections)) {
        return { schema_version: typeof content.schema_version === 'number' ? content.schema_version : 1, sections: content.sections };
      }
      return { schema_version: 1, sections: [] };
    }

    function collectSections(base: Record<string, unknown>[]): Record<string, unknown>[] {
      const byType = new Map(base.filter((s) => typeof s.type === 'string').map((s) => [s.type as string, { ...s }]));
      const heroEnabled = (document.getElementById('hero-enabled') as HTMLInputElement | null)?.checked !== false;
      const hero = byType.get('hero_comic') ?? { type: 'hero_comic', sort_order: 1 };
      hero.enabled = heroEnabled;
      const eyebrow = val('hero-eyebrow');
      const headline = val('hero-headline');
      const ctaLabel = val('hero-cta-label');
      const ctaTarget = val('hero-cta-target');
      if (eyebrow) hero.eyebrow = eyebrow;
      if (headline) hero.headline = headline;
      if (ctaLabel) hero.cta_label = ctaLabel;
      if (ctaTarget) hero.cta_target = ctaTarget;
      byType.set('hero_comic', hero);

      document.querySelectorAll<HTMLElement>('[data-section-row]').forEach((row) => {
        const type = row.dataset.sectionRow || '';
        if (!type || type === 'hero_comic') return;
        const section = byType.get(type) ?? { type, sort_order: 99 };
        const enabledBox = row.querySelector<HTMLInputElement>('input[data-field="enabled"]');
        const sortBox = row.querySelector<HTMLInputElement>('input[data-field="sort_order"]');
        section.enabled = enabledBox ? enabledBox.checked : true;
        const sort = sortBox ? parseInt(sortBox.value, 10) : NaN;
        section.sort_order = Number.isFinite(sort) ? sort : 99;
        byType.set(type, section);
      });

      return [...byType.values()].sort(
        (a, b) => ((a.sort_order as number) ?? 99) - ((b.sort_order as number) ?? 99),
      );
    }

    async function save(publish: boolean) {
      const base = await loadBaseContent();
      if (!base) return;
      const content = { schema_version: base.schema_version, sections: collectSections(base.sections) };
      const created = await mutate<{ id: number }>('/admin/pages/home/revisions', 'POST', { content });
      if (created.error || !created.data) return fail(created.error?.message || 'Tạo nháp thất bại.');
      if (publish) {
        const pub = await mutate(`/admin/pages/home/revisions/${created.data.id}/publish`, 'POST', {});
        if (pub.error) return fail(pub.error.message || 'Xuất bản thất bại.');
      }
      window.location.reload();
    }

    document.getElementById('cms-draft')?.addEventListener('click', () => save(false));
    document.getElementById('cms-publish')?.addEventListener('click', () => save(true));

    document.querySelectorAll('button[data-publish-rev]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const revId = (btn as HTMLElement).dataset.publishRev;
        if (!confirm(`Xuất bản revision #${revId}? Storefront sẽ cập nhật ngay.`)) return;
        const { error } = await mutate(`/admin/pages/home/revisions/${revId}/publish`, 'POST', {});
        if (error) return fail(error.message || 'Xuất bản thất bại.');
        window.location.reload();
      });
    });
  </script>
</AdminLayout>
