---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import { apiGet, requireStaff } from '../../lib/api';
import { formatCurrency, formatDate } from '../../lib/formatters';

export const prerender = false;

const { redirect } = await requireStaff(Astro);
if (redirect) return redirect;

const { id } = Astro.params;

interface CustDetail {
  user: { id: number; name: string; email: string; phone?: string | null; status: string; addresses: { line1: string; district?: string | null; province?: string | null }[] };
  stats: { orders_count: number; total_spent: number };
  orders: { id: number; order_number: string; order_status: string; total_amount: number }[];
}

const { data: detail } = await apiGet<CustDetail>(`/admin/customers/${id}`, Astro);
if (!detail) return Astro.redirect('/customers');
const customer = detail.user;
const customerOrders = detail.orders;
---

<AdminLayout
  title={`Hồ sơ khách hàng: ${customer.name}`}
  description={`Tổng chi tiêu trọn đời: ${formatCurrency(detail.stats.total_spent)} • ${detail.stats.orders_count} đơn`}
  breadcrumbs={[
    { label: 'Bán hàng', href: '/orders' },
    { label: 'Khách hàng', href: '/customers' },
    { label: customer.name },
  ]}
>
  <div slot="actions">
    <Button variant="secondary" size="sm" href="/customers">
      ← Danh sách khách hàng
    </Button>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Left Column: Customer Info & Notes (1/3) -->
    <div class="space-y-6">
      <div class="bg-white rounded-[14px] border border-[#D8D4D0] p-5 shadow-xs text-center">
        <div class="w-20 h-20 rounded-full mx-auto bg-[#17141F] text-white flex items-center justify-center font-black text-[28px] border-2 border-[#17141F] mb-3">
          {customer.name.charAt(0)}
        </div>
        <h2 class="text-[18px] font-black text-[#17141F]">
          {customer.name}
        </h2>
        <div class="mt-1">
          <Badge variant="brand" size="sm">
            Khách hàng
          </Badge>
        </div>

        <div class="mt-5 text-left text-[13px] space-y-2.5 pt-4 border-t border-[#F2EFE9]">
          <div>
            <span class="text-[#6A6572] block">Email:</span>
            <strong class="text-[#17141F]">{customer.email}</strong>
          </div>
          <div>
            <span class="text-[#6A6572] block">Số điện thoại:</span>
            <strong class="text-[#17141F]">{customer.phone ?? '—'}</strong>
          </div>
          <div>
            <span class="text-[#6A6572] block">Địa chỉ đã lưu:</span>
            {customer.addresses.length === 0 && <span class="text-[#534F5C]">Chưa có</span>}
            {customer.addresses.map((a) => (
              <div class="text-[#534F5C]">{a.line1}{a.district ? `, ${a.district}` : ''}{a.province ? `, ${a.province}` : ''}</div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Order History (2/3) -->
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white rounded-[14px] border border-[#D8D4D0] shadow-xs overflow-hidden">
        <div class="p-4 border-b border-[#D8D4D0] flex items-center justify-between">
            <h2 class="text-[16px] font-bold text-[#17141F]">
            Lịch sử đơn hàng của khách ({customerOrders.length})
          </h2>
          <span class="text-[12px] text-[#6A6572]">Tổng chi tiêu: <strong class="text-[#D6284F]">{formatCurrency(detail.stats.total_spent)}</strong></span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-[13px] border-collapse">
            <thead>
              <tr class="bg-[#FAF8F5] border-b border-[#D8D4D0] text-[#534F5C] text-[11px] font-bold uppercase tracking-wider">
                <th class="py-3 px-4">Mã đơn</th>
                <th class="py-3 px-4">Trạng thái</th>
                <th class="py-3 px-4 text-right">Tổng thanh toán</th>
                <th class="py-3 px-4 text-center">Thao tác</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#F2EFE9]">
              {customerOrders.length === 0 && (
                <tr><td colspan="4" class="py-6 text-center text-[12px] text-[#6A6572]">Khách chưa có đơn hàng nào.</td></tr>
              )}
              {customerOrders.map((ord) => (
                <tr class="hover:bg-[#FDFBF7]">
                  <td class="py-3.5 px-4 font-mono font-bold text-[#3258D7]">
                    <a href={`/orders/${ord.id}`} class="hover:underline">{ord.order_number}</a>
                  </td>
                  <td class="py-3.5 px-4">
                    <Badge variant={ord.order_status === 'completed' ? 'success' : ord.order_status === 'cancelled' ? 'danger' : 'warning'} size="sm">
                      {ord.order_status}
                    </Badge>
                  </td>
                  <td class="py-3.5 px-4 text-right font-bold text-[#17141F] tabular-nums">
                    {formatCurrency(ord.total_amount)}
                  </td>
                  <td class="py-3.5 px-4 text-center">
                    <Button variant="secondary" size="sm" href={`/orders/${ord.id}`}>
                      Xem đơn
                    </Button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>
