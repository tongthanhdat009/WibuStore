---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import { apiGet, currentPage, requireStaff } from '../../lib/api';
import Pagination from '../../components/ui/Pagination.astro';
import { formatCurrency, formatDate } from '../../lib/formatters';

const page = currentPage(Astro);

interface Customer { id: number; public_id: string; name: string; email: string; phone?: string | null; status: string }

const q = Astro.url.searchParams.get('q') ?? '';
const statusFilter = Astro.url.searchParams.get('status') ?? '';
const listParams: Record<string, string> = { per_page: '20', page: String(page) };
if (q) listParams.q = q;
if (statusFilter) listParams.status = statusFilter;
const [staffRes, custRes] = await Promise.all([
  requireStaff(Astro),
  apiGet<Customer[]>(`/admin/customers?${new URLSearchParams(listParams).toString()}`, Astro),
]);
if (staffRes.redirect) return staffRes.redirect;
const { data: custData, meta: custMeta } = custRes;
const customers = custData ?? [];
const pageParams: Record<string, string> = {
  ...(q ? { q } : {}),
  ...(statusFilter ? { status: statusFilter } : {}),
};
---

<AdminLayout
  title="Khách hàng & Hội viên (Collectors)"
  description="Quản lý hồ sơ người mua, lịch sử chi tiêu, phân hạng thành viên VIP Wibu và hỗ trợ chăm sóc khách hàng"
  breadcrumbs={[{ label: 'Bán hàng' }, { label: 'Khách hàng' }]}
>
  <div slot="actions">
    <button id="export-csv-btn" type="button" class="inline-flex items-center px-3 py-1.5 h-8 rounded-[8px] bg-white border border-[#D8D4D0] hover:border-[#17141F] text-[13px] font-bold text-[#17141F] shadow-xs cursor-pointer">
      Xuất CSV khách hàng
    </button>
  </div>

  <div class="bg-white rounded-[14px] border border-[#D8D4D0] shadow-xs overflow-hidden">
    <div class="p-4 border-b border-[#D8D4D0] bg-[#FAF8F5] flex flex-wrap items-center gap-3">
      <form action="/customers" method="GET" class="relative w-full sm:w-64">
        {statusFilter && <input type="hidden" name="status" value={statusFilter} />}
        <input
          type="text"
          name="q"
          value={q}
          placeholder="Tìm tên, email, số điện thoại..."
          class="w-full h-9 pl-8 pr-3 text-[13px] bg-white border border-[#D8D4D0] rounded-[6px] focus:outline-none focus:ring-2 focus:ring-[#3258D7]"
        />
        <svg class="w-4 h-4 text-[#6A6572] absolute left-2.5 top-2.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </form>

      <form action="/customers" method="GET" class="contents">
        {q && <input type="hidden" name="q" value={q} />}
        <select name="status" onchange="this.form.submit()" class="h-9 px-3 text-[13px] font-medium bg-white border border-[#D8D4D0] rounded-[6px] text-[#17141F] cursor-pointer">
          <option value="">Tất cả trạng thái</option>
          <option value="active" selected={statusFilter === 'active'}>Hoạt động</option>
          <option value="suspended" selected={statusFilter === 'suspended'}>Tạm khóa</option>
        </select>
      </form>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-[13px] border-collapse">
        <thead>
          <tr class="bg-[#FAF8F5] border-b border-[#D8D4D0] text-[#534F5C] text-[11px] font-bold uppercase tracking-wider">
            <th class="py-3.5 px-4">Khách hàng</th>
            <th class="py-3.5 px-4 text-center">Trạng thái</th>
            <th class="py-3.5 px-4 text-center">Thao tác</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#F2EFE9]">
          {customers.map((c) => (
            <tr class="hover:bg-[#FDFBF7] transition-colors">
              <td class="py-4 px-4">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-[#17141F] text-white flex items-center justify-center font-bold shrink-0">
                    {c.name.charAt(0)}
                  </div>
                  <div>
                    <div class="font-bold text-[#17141F] block">
                      {c.name}
                    </div>
                    <div class="text-[11px] text-[#6A6572]">{c.email} • {c.phone ?? '—'}</div>
                  </div>
                </div>
              </td>
              <td class="py-4 px-4 text-center">
                <Badge variant={c.status === 'active' ? 'success' : c.status === 'suspended' ? 'warning' : 'neutral'} size="sm">{c.status === 'active' ? 'Hoạt động' : c.status === 'suspended' ? 'Tạm khóa' : c.status}</Badge>
              </td>
              <td class="py-4 px-4 text-center">
                <Button variant="secondary" size="sm" href={`/customers/${c.id}`}>
                  Hồ sơ
                </Button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <Pagination meta={custMeta} pathname="/customers" params={pageParams} />
  </div>

  <script>
    import { downloadCSV } from '../../lib/export';

    document.getElementById('export-csv-btn')?.addEventListener('click', async () => {
      try {
        const base = (import.meta.env.PUBLIC_API_URL as string | undefined) || 'http://localhost:8000';
        const res = await fetch(`${base}/api/v1/admin/customers?per_page=100`, { credentials: 'include', headers: { Accept: 'application/json' } });
        const json = await res.json();
        const rows = (json?.data ?? []).map((c: { name: string; email: string; phone?: string; status: string }) => [
          c.name, c.email, c.phone ?? '', c.status,
        ]);
        downloadCSV('customers.csv', ['Tên', 'Email', 'SĐT', 'Trạng thái'], rows);
      } catch {
        alert('Xuất thất bại. Kiểm tra đăng nhập.');
      }
    });
  </script>
</AdminLayout>
