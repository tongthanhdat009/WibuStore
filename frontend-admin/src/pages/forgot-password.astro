---
import AuthLayout from '../layouts/AuthLayout.astro';
import Button from '../components/ui/Button.astro';
import Input from '../components/ui/Input.astro';
---

<AuthLayout title="Khôi phục tài khoản">
  <form id="forgot-form" class="space-y-4">
    <p class="text-[13px] text-[#534F5C] leading-relaxed">
      Nhập địa chỉ email doanh nghiệp của bạn để nhận liên kết xác thực đặt lại mật khẩu quản trị.
    </p>

    <div id="forgot-msg" class="hidden p-3 rounded-[8px] text-[12px]"></div>

    <Input
      label="Email nhân sự"
      name="email"
      type="email"
      placeholder="ten.nv@wibustore.vn"
      required
    />

    <div class="pt-2 flex flex-col gap-2">
      <Button variant="primary" size="lg" type="submit" class="w-full">
        Gửi yêu cầu khôi phục
      </Button>
      <Button variant="ghost" size="md" href="/login" class="w-full text-center">
        ← Quay lại trang đăng nhập
      </Button>
    </div>
  </form>
</AuthLayout>

<script>
  import { mutate } from '../lib/api';

  document.getElementById('forgot-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const email = String(new FormData(form).get('email') || '');
    const msg = document.getElementById('forgot-msg');
    const { error } = await mutate('/auth/forgot-password', 'POST', { email });
    if (msg) {
      msg.classList.remove('hidden');
      if (error) {
        msg.className = 'p-3 rounded-[8px] text-[12px] bg-[#FFF0F3] border border-[#D6284F]/30 text-[#A61B3F]';
        msg.textContent = error.message || 'Gửi thất bại.';
      } else {
        msg.className = 'p-3 rounded-[8px] text-[12px] bg-[#EDF7F0] border border-[#147A4B]/30 text-[#147A4B]';
        msg.textContent = 'Đã gửi liên kết đặt lại mật khẩu. Kiểm tra email của bạn.';
      }
    }
  });
</script>
