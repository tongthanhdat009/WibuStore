---
import AdminLayout from '../layouts/AdminLayout.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
import { mockReviews } from '../data/mockData';
import { formatDateTime } from '../lib/formatters';

const reviews = mockReviews;
---

<AdminLayout
  title="Đánh giá & Kiểm duyệt (Reviews)"
  description="Duyệt bài đánh giá, hình ảnh unbox và phản hồi từ cộng đồng sưu tầm figure trước khi hiển thị công khai"
  breadcrumbs={[{ label: 'Nội dung & Marketing' }, { label: 'Đánh giá' }]}
>
  <div class="flex items-center gap-2 border-b border-[#D8D4D0] pb-3">
    <button class="px-3.5 py-1.5 rounded-[8px] bg-[#17141F] text-white font-bold text-[13px]">
      Chờ kiểm duyệt (1)
    </button>
    <button class="px-3.5 py-1.5 rounded-[8px] bg-white border border-[#D8D4D0] text-[#534F5C] font-semibold text-[13px]">
      Đã phê duyệt (1)
    </button>
    <button class="px-3.5 py-1.5 rounded-[8px] bg-white border border-[#D8D4D0] text-[#534F5C] font-semibold text-[13px]">
      Bị từ chối / Vi phạm (0)
    </button>
  </div>

  <div class="space-y-4">
    {reviews.map((rev) => (
      <div class="bg-white rounded-[14px] border border-[#D8D4D0] p-5 shadow-xs flex flex-col sm:flex-row items-start justify-between gap-4">
        <div class="flex items-start gap-4">
          <img
            src={rev.productImage}
            alt=""
            class="w-16 h-16 rounded-[8px] object-cover border border-[#D8D4D0] shrink-0"
          />
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="font-bold text-[#17141F] text-[14px]">{rev.customerName}</span>
              <span class="text-[#D8D4D0]">•</span>
              <span class="text-[#FFD44A] text-[13px] font-bold">★ {rev.rating}.0 / 5.0</span>
              <span class="text-[#D8D4D0]">•</span>
              <span class="text-[12px] text-[#6A6572]">{formatDateTime(rev.createdAt)}</span>
            </div>

            <div class="text-[12px] font-semibold text-[#D6284F] mb-1.5">
              Đánh giá sản phẩm: {rev.productName}
            </div>

            <p class="text-[13px] text-[#17141F] bg-[#FAF8F5] p-3 rounded-[8px] border border-[#E8E5E1] max-w-2xl leading-relaxed">
              "{rev.content}"
            </p>
          </div>
        </div>

        <div class="flex items-center gap-2 self-end sm:self-center shrink-0">
          {rev.status === 'pending' ? (
            <>
              <Button variant="primary" size="sm">
                Phê duyệt hiển thị
              </Button>
              <Button variant="danger" size="sm">
                Từ chối
              </Button>
            </>
          ) : (
            <Badge variant="success" size="md">
              ✓ Đã hiển thị ngoài Storefront
            </Badge>
          )}
        </div>
      </div>
    ))}
  </div>
</AdminLayout>
