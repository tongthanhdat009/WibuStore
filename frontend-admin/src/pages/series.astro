---
import AdminLayout from '../layouts/AdminLayout.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
import { apiGet, requireStaff } from '../lib/api';

const { redirect } = await requireStaff(Astro);
if (redirect) return redirect;

interface Row { id: number; name: string; slug: string; products_count: number }

const { data: rowData } = await apiGet<Row[]>('/admin/anime-series', Astro);
const mockSeries = rowData ?? [];
---

<AdminLayout
  title="Anime Series & Nhân vật"
  description="Quản lý hệ thống series anime, danh sách nhân vật cho catalog và bộ lọc tìm kiếm"
  breadcrumbs={[{ label: 'Sản phẩm' }, { label: 'Anime Series' }]}
>
  <div slot="actions">
    <button id="open-row-modal" type="button" class="inline-flex items-center px-3 py-1.5 h-8 rounded-[8px] bg-[#17141F] text-white text-[13px] font-bold cursor-pointer">
      + Thêm Anime Series mới
    </button>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {mockSeries.map((s) => (
      <div class="bg-white rounded-[14px] border border-[#D8D4D0] p-5 shadow-xs flex flex-col justify-between hover:shadow transition-all">
        <div>
          <div class="flex items-center justify-between gap-2 mb-2">
            <span class="w-3 h-3 rounded-full bg-[#D6284F]"></span>
            <Badge variant="brand" size="sm">{s.products_count} mô hình</Badge>
          </div>
          <h3 class="text-[17px] font-black text-[#17141F]">
            {s.name}
          </h3>
          <p class="text-[12px] font-mono text-[#6A6572] mt-0.5">
            Slug: {s.slug}
          </p>
        </div>

        <div class="mt-4 pt-3 border-t border-[#F2EFE9] flex items-center justify-between">
          <a href={`http://localhost:4321/anime/${s.slug}`} target="_blank" class="text-[12px] text-[#3258D7] hover:underline font-semibold">
            Xem storefront ↗
          </a>
        </div>
      </div>
    ))}
  </div>

  <div id="row-modal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-4">
    <div class="bg-white rounded-[16px] max-w-md w-full p-6 border-2 border-[#17141F] space-y-4">
      <div class="flex items-center justify-between border-b border-[#F2EFE9] pb-3">
        <h3 class="text-[16px] font-black text-[#17141F]">Thêm series mới</h3>
        <button type="button" data-close-modal class="text-[#6A6572] hover:text-[#17141F] font-bold text-lg cursor-pointer">✕</button>
      </div>
      <div id="row-error" class="hidden p-3 rounded-[8px] bg-[#FFF0F3] border border-[#D6284F]/30 text-[12px] text-[#A61B3F]"></div>
      <div class="space-y-3 text-[13px]">
        <input id="row-name" placeholder="Tên series" class="w-full h-10 px-3 rounded-[8px] border border-[#D8D4D0]" />
        <input id="row-slug" placeholder="slug (vd: one-piece)" class="w-full h-10 px-3 rounded-[8px] border border-[#D8D4D0]" />
      </div>
      <div class="flex items-center justify-end gap-2 pt-2 border-t border-[#F2EFE9]">
        <button type="button" data-close-modal class="px-4 h-10 rounded-[8px] border border-[#D8D4D0] font-bold text-[13px] cursor-pointer">Hủy</button>
        <button id="row-submit" type="button" class="px-4 h-10 rounded-[8px] bg-[#17141F] text-white font-bold text-[13px] cursor-pointer">+ Thêm</button>
      </div>
    </div>
  </div>

  <script>
    import { mutate } from '../lib/api';

    const rowModal = document.getElementById('row-modal');
    document.getElementById('open-row-modal')?.addEventListener('click', () => {
      rowModal?.classList.remove('hidden');
      rowModal?.classList.add('flex');
    });
    rowModal?.querySelectorAll('[data-close-modal]').forEach((btn) => {
      btn.addEventListener('click', () => {
        rowModal?.classList.add('hidden');
        rowModal?.classList.remove('flex');
      });
    });

    document.getElementById('row-submit')?.addEventListener('click', async () => {
      const name = ((document.getElementById('row-name') as HTMLInputElement | null)?.value || '').trim();
      const slug = ((document.getElementById('row-slug') as HTMLInputElement | null)?.value || '').trim();
      const errEl = document.getElementById('row-error');
      if (!name || !slug) {
        if (errEl) {
          errEl.textContent = 'Nhập tên và slug.';
          errEl.classList.remove('hidden');
        }
        return;
      }
      const { error } = await mutate('/admin/anime-series', 'POST', { name, slug });
      if (error) {
        if (errEl) {
          errEl.textContent = error.message || 'Thêm thất bại.';
          errEl.classList.remove('hidden');
        }
        return;
      }
      window.location.reload();
    });
  </script>
</AdminLayout>
