---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import { apiGet, currentPage, requireStaff } from '../../lib/api';
import Pagination from '../../components/ui/Pagination.astro';

const { redirect } = await requireStaff(Astro);
if (redirect) return redirect;
const page = currentPage(Astro);

interface LogRow { id: number; actor_name?: string | null; action: string; subject_type?: string | null; subject_id?: string | null; request_id?: string | null; created_at: string }

const { data: logData, meta: logMeta } = await apiGet<LogRow[]>(`/admin/activity-logs?per_page=20&page=${page}`, Astro);
const logs = logData ?? [];

const ACTION_LABELS: Record<string, string> = {
  'order.created': 'Tạo đơn hàng',
  'order.transition': 'Chuyển trạng thái đơn',
  'payment.confirmed': 'Xác nhận thanh toán',
  'payment.rejected': 'Từ chối thanh toán',
  'product.created': 'Tạo sản phẩm',
  'product.updated': 'Sửa sản phẩm',
  'product.published': 'Xuất bản sản phẩm',
  'product.archived': 'Lưu trữ sản phẩm',
  'inventory.adjusted': 'Điều chỉnh tồn kho',
  'cms.published': 'Xuất bản nội dung',
  'review.moderated': 'Kiểm duyệt đánh giá',
  'user.created': 'Tạo tài khoản',
  'user.updated': 'Sửa tài khoản',
  'user.deleted': 'Xóa tài khoản',
  'user.roles_updated': 'Đổi vai trò',
  'role.created': 'Tạo vai trò',
  'role.updated': 'Sửa vai trò',
  'role.deleted': 'Xóa vai trò',
};
const actionLabel = (code: string) => ACTION_LABELS[code] ?? code;
---

<AdminLayout
  title="Nhật ký hoạt động hệ thống (Audit Logs)"
  description="Ghi nhận mọi thao tác nhạy cảm, thay đổi dữ liệu đơn, xuất bản sản phẩm và điều chỉnh kho figure"
  breadcrumbs={[{ label: 'Hệ thống' }, { label: 'Nhật ký hoạt động' }]}
>
  <div slot="actions">
    <Button variant="secondary" size="sm">
      Xuất tệp nhật ký
    </Button>
  </div>

  <div class="bg-white rounded-[14px] border border-[#D8D4D0] shadow-xs overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-[13px] border-collapse">
        <thead>
          <tr class="bg-[#FAF8F5] border-b border-[#D8D4D0] text-[#534F5C] text-[11px] font-bold uppercase tracking-wider">
            <th class="py-3.5 px-4">Thời gian</th>
            <th class="py-3.5 px-4">Người thực hiện</th>
            <th class="py-3.5 px-4">Hành động (Action)</th>
            <th class="py-3.5 px-4">Tài nguyên</th>
            <th class="py-3.5 px-4 font-mono">Request ID</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#F2EFE9]">
          {logs.map((l) => (
            <tr class="hover:bg-[#FDFBF7] transition-colors">
              <td class="py-3.5 px-4 text-[12px] text-[#6A6572] tabular-nums whitespace-nowrap">
                {l.created_at}
              </td>
              <td class="py-3.5 px-4 font-bold text-[#17141F]">
                {l.actor_name ?? 'hệ thống'}
              </td>
              <td class="py-3.5 px-4">
                <span class="text-[12px] font-bold text-[#17141F]">{actionLabel(l.action)}</span>
                <span class="block font-mono text-[11px] text-[#6A6572]">{l.action}</span>
              </td>
              <td class="py-3.5 px-4 text-[#534F5C]">
                {l.subject_type ?? '—'} <span class="font-mono text-[11px] text-[#6A6572]">({l.subject_id ?? '—'})</span>
              </td>
              <td class="py-3.5 px-4 font-mono text-[11px] text-[#6A6572]">
                {l.request_id ?? '—'}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <Pagination meta={logMeta} pathname="/settings/audit-logs" params={{}} />
  </div>
</AdminLayout>
