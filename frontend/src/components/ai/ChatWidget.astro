---
// Floating AI chat: có mặt mọi trang, gọi POST /api/v1/ai/chat (text)
// hoặc /api/v1/ai/vision (kèm ảnh). Lịch sử giữ trong sessionStorage.
---

<button
  id="ai-chat-fab"
  type="button"
  aria-label="Mở chat AI"
  class="fixed bottom-5 right-5 z-[60] w-14 h-14 rounded-full bg-[#D6284F] text-white border-[3px] border-[#17141F] shadow-[4px_4px_0px_#17141F] hover:bg-[#AF1E40] hover:-translate-y-0.5 transition-all flex items-center justify-center cursor-pointer"
>
  <span class="text-2xl leading-none">✦</span>
  <span class="absolute top-0.5 right-0.5 w-3 h-3 rounded-full bg-[#4ADE80] border-2 border-[#17141F]"></span>
</button>

<div
  id="ai-chat-window"
  role="dialog"
  aria-label="Chat với AI Assistant"
  class="fixed z-[60] hidden flex-col overflow-hidden bg-[#FFFDF7] border-[3px] border-[#17141F] shadow-[6px_6px_0px_#17141F] rounded-2xl inset-0 sm:inset-auto sm:bottom-24 sm:right-5 sm:w-[400px] sm:h-[560px] sm:max-h-[75vh]"
>
  <!-- Header -->
  <div class="flex items-center gap-2.5 px-4 py-3 bg-[#17141F] text-white shrink-0">
    <div class="w-9 h-9 rounded-xl bg-[#FFD44A] text-[#17141F] border-2 border-white/80 flex items-center justify-center text-xl font-bold shrink-0">
      ✦
    </div>
    <div class="flex-1 min-w-0">
      <p class="font-display text-sm tracking-wider leading-none">AI ASSISTANT</p>
      <p class="text-[11px] text-[#4ADE80] font-bold flex items-center gap-1 mt-0.5">
        <span class="w-1.5 h-1.5 rounded-full bg-[#4ADE80] animate-pulse"></span> Online
      </p>
    </div>
    <button id="ai-chat-clear" type="button" title="Xóa hội thoại" class="w-8 h-8 rounded-lg hover:bg-white/15 text-white/80 hover:text-white text-sm transition-colors cursor-pointer">🗑</button>
    <button id="ai-chat-hide" type="button" title="Thu nhỏ" class="w-8 h-8 rounded-lg hover:bg-white/15 text-white font-bold transition-colors cursor-pointer">–</button>
    <button id="ai-chat-close" type="button" title="Đóng" class="w-8 h-8 rounded-lg hover:bg-white/15 text-white font-bold transition-colors cursor-pointer">✕</button>
  </div>

  <!-- Messages -->
  <div id="ai-chat-messages" class="flex-1 overflow-y-auto px-3.5 py-4 space-y-3 bg-[#FFFDF7]"></div>

  <!-- Quick actions -->
  <div id="ai-chat-quick" class="px-3.5 pb-2 flex flex-wrap gap-2 shrink-0"></div>

  <!-- Attach preview -->
  <div id="ai-chat-attach" class="hidden px-3.5 pb-2 shrink-0 items-center gap-2">
    <img id="ai-chat-attach-img" alt="Ảnh đính kèm" class="w-12 h-12 rounded-lg border-2 border-[#17141F] object-cover" />
    <span class="text-[11px] font-bold text-[#534F5C] flex-1 truncate">Đã đính kèm ảnh — sẽ dùng AI đọc ảnh</span>
    <button id="ai-chat-attach-remove" type="button" class="text-xs font-bold text-[#D6284F] hover:underline cursor-pointer">Gỡ</button>
  </div>

  <!-- Input -->
  <form id="ai-chat-form" class="p-3 border-t-2 border-[#17141F] bg-white shrink-0 flex items-center gap-2">
    <input id="ai-chat-file" type="file" accept="image/jpeg,image/png,image/webp" class="hidden" />
    <button
      id="ai-chat-attach-btn"
      type="button"
      title="Đính kèm ảnh"
      class="w-10 h-10 shrink-0 rounded-xl border-2 border-[#17141F] bg-[#F7F5F0] hover:bg-[#FFD44A] font-bold text-lg transition-colors cursor-pointer"
    >+</button>
    <input
      id="ai-chat-input"
      type="text"
      maxlength="1000"
      autocomplete="off"
      placeholder="Nhập tin nhắn..."
      class="flex-1 min-w-0 bg-[#F7F5F0] text-sm font-medium text-[#17141F] placeholder-[#6A6572] px-3.5 py-2.5 rounded-xl border-2 border-[#17141F] focus:outline-none focus:bg-white transition-colors"
    />
    <button
      id="ai-chat-send"
      type="submit"
      aria-label="Gửi"
      class="w-10 h-10 shrink-0 rounded-xl border-2 border-[#17141F] bg-[#D6284F] hover:bg-[#AF1E40] text-white shadow-[2px_2px_0px_#17141F] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all flex items-center justify-center cursor-pointer"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
    </button>
  </form>
</div>

<style>
  .ai-md .ai-p { margin: 0 0 0.35rem; line-height: 1.5; }
  .ai-md .ai-p:last-child { margin-bottom: 0; }
  .ai-md strong { font-weight: 800; }
  .ai-md em { font-style: italic; }
  .ai-md .ai-code { font-family: ui-monospace, monospace; font-size: 0.8em; background: #F7F5F0; border: 1px solid #17141F; border-radius: 6px; padding: 0.05rem 0.35rem; }
  .ai-md .ai-pre { font-family: ui-monospace, monospace; font-size: 0.75rem; background: #17141F; color: #FFFDF7; border-radius: 10px; padding: 0.6rem 0.75rem; overflow-x: auto; margin: 0.35rem 0; white-space: pre-wrap; }
  .ai-md .ai-link { color: #D6284F; font-weight: 700; text-decoration: underline; }
  .ai-md .ai-img { display: block; max-width: 100%; border-radius: 12px; border: 2px solid #17141F; margin: 0.35rem 0; }
  .ai-md .ai-ul, .ai-md .ai-ol { margin: 0.25rem 0 0.4rem 1.1rem; display: flex; flex-direction: column; gap: 0.2rem; }
  .ai-md .ai-ul { list-style: disc; }
  .ai-md .ai-ol { list-style: decimal; }
</style>

<script>
  import { postAiChat, postAiVision } from '../../lib/ai';

  interface ChatMsg { role: 'user' | 'ai'; text: string; ts: number }
  const STORE_KEY = 'wibu_ai_chat';
  const QUICK = ['Tư vấn figure dưới 1 triệu', 'Nendoroid là gì?', 'Cách dùng AI nhận diện ảnh'];

  const fab = document.getElementById('ai-chat-fab') as HTMLButtonElement;
  const win = document.getElementById('ai-chat-window') as HTMLDivElement;
  const list = document.getElementById('ai-chat-messages') as HTMLDivElement;
  const quick = document.getElementById('ai-chat-quick') as HTMLDivElement;
  const form = document.getElementById('ai-chat-form') as HTMLFormElement;
  const input = document.getElementById('ai-chat-input') as HTMLInputElement;
  const fileInput = document.getElementById('ai-chat-file') as HTMLInputElement;
  const attachBar = document.getElementById('ai-chat-attach') as HTMLDivElement;
  const attachImg = document.getElementById('ai-chat-attach-img') as HTMLImageElement;
  let attached: File | null = null;
  let sending = false;

  function loadHistory(): ChatMsg[] {
    try { return JSON.parse(sessionStorage.getItem(STORE_KEY) || '[]'); } catch { return []; }
  }
  function saveHistory(msgs: ChatMsg[]) {
    try { sessionStorage.setItem(STORE_KEY, JSON.stringify(msgs.slice(-50))); } catch {}
  }

  const GREETING = 'Konbanwa~\nEm là **Hikari-chan**, trợ lý của **Wibu Store** ✦\nBạn muốn em tư vấn figure, đọc ảnh mô hình hay gợi ý đồ cosplay nè?';

  /** Markdown mini cho tin nhắn AI: escape HTML trước rồi chỉ render bold/italic/code/link/image/list. */
  function renderMarkdown(src: string): string {
    const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    const codeBlocks: string[] = [];
    let text = esc(src);
    // Giữ code block ```...``` khỏi bị parse tiếp.
    text = text.replace(/```([\s\S]*?)```/g, (_, code) => {
      codeBlocks.push(`<pre class="ai-pre">${code}</pre>`);
      return `\u0000${codeBlocks.length - 1}\u0000`;
    });
    text = text
      .replace(/`([^`\n]+)`/g, '<code class="ai-code">$1</code>')
      .replace(/!\[([^\]\n]*)\]\((https?:[^)\s]+)\)/g, '<img src="$2" alt="$1" loading="lazy" class="ai-img" />')
      .replace(/\*\*([^\*\n]+)\*\*/g, '<strong>$1</strong>')
      .replace(/(^|[\s(])\*([^\*\n]+)\*/g, '$1<em>$2</em>')
      .replace(/\[([^\]\n]+)\]\((https?:[^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noopener" class="ai-link">$1</a>');
    // List theo dòng: "- item" / "* item" / "1. item".
    const lines = text.split(/\n/);
    let html = '';
    let openList: 'ul' | 'ol' | null = null;
    const closeList = () => { if (openList) { html += `</${openList}>`; openList = null; } };
    for (const line of lines) {
      const ul = line.match(/^\s*[-*]\s+(.*)$/);
      const ol = line.match(/^\s*\d+[.)]\s+(.*)$/);
      if (ul) {
        if (openList !== 'ul') { closeList(); html += '<ul class="ai-ul">'; openList = 'ul'; }
        html += `<li>${ul[1]}</li>`;
      } else if (ol) {
        if (openList !== 'ol') { closeList(); html += '<ol class="ai-ol">'; openList = 'ol'; }
        html += `<li>${ol[1]}</li>`;
      } else if (line.trim() === '') {
        closeList();
        html += '<br>';
      } else {
        closeList();
        html += `<p class="ai-p">${line}</p>`;
      }
    }
    closeList();
    // Trả lại code block.
    html = html.replace(/\u0000(\d+)\u0000/g, (_, i) => codeBlocks[Number(i)] ?? '');
    return html;
  }

  function bubble(role: 'user' | 'ai', text: string) {
    const wrap = document.createElement('div');
    wrap.className = role === 'user' ? 'flex justify-end' : 'flex justify-start';
    const b = document.createElement('div');
    b.className = role === 'user'
      ? 'max-w-[80%] px-3.5 py-2.5 rounded-2xl rounded-br-md bg-[#17141F] text-white text-sm font-medium border-2 border-[#17141F] whitespace-pre-wrap break-words'
      : 'max-w-[85%] px-3.5 py-2.5 rounded-2xl rounded-bl-md bg-white text-sm text-[#17141F] border-2 border-[#17141F] shadow-[2px_2px_0px_#17141F] break-words ai-md';
    if (role === 'ai') {
      b.innerHTML = renderMarkdown(text);
    } else {
      b.textContent = text;
    }
    wrap.appendChild(b);
    list.appendChild(wrap);
    list.scrollTop = list.scrollHeight;
    return wrap;
  }

  function productCards(products: { name: string; slug: string; price_amount: number | null; image?: string | null; url: string }[]): HTMLDivElement {
    const wrap = document.createElement('div');
    wrap.className = 'flex flex-col gap-1.5 mt-1.5';
    products.slice(0, 5).forEach((p) => {
      const a = document.createElement('a');
      a.href = p.url;
      a.className = 'flex items-center gap-2.5 p-1.5 pr-3 rounded-xl bg-white border-2 border-[#17141F] shadow-[2px_2px_0px_#17141F] hover:bg-[#FFF4DC] hover:-translate-y-px transition-all';
      const img = document.createElement('img');
      img.src = p.image || '/favicon.svg';
      img.alt = p.name;
      img.loading = 'lazy';
      img.className = 'w-11 h-11 rounded-lg object-cover border border-[#17141F] shrink-0 bg-[#F7F5F0]';
      const info = document.createElement('div');
      info.className = 'min-w-0 flex-1';
      const name = document.createElement('p');
      name.className = 'text-xs font-bold text-[#17141F] truncate';
      name.textContent = p.name;
      const price = document.createElement('p');
      price.className = 'text-xs font-extrabold text-[#D6284F]';
      price.textContent = typeof p.price_amount === 'number'
        ? p.price_amount.toLocaleString('vi-VN') + ' đ'
        : 'Liên hệ';
      info.appendChild(name);
      info.appendChild(price);
      const arrow = document.createElement('span');
      arrow.className = 'text-[#D6284F] font-black text-sm shrink-0';
      arrow.textContent = '›';
      a.appendChild(img);
      a.appendChild(info);
      a.appendChild(arrow);
      wrap.appendChild(a);
    });
    return wrap;
  }

  function typingOn(): HTMLDivElement {
    const wrap = document.createElement('div');
    wrap.className = 'flex justify-start';
    wrap.innerHTML = '<div class="px-4 py-3 rounded-2xl rounded-bl-md bg-white border-2 border-[#17141F] shadow-[2px_2px_0px_#17141F] flex gap-1"><span class="w-2 h-2 rounded-full bg-[#534F5C] animate-bounce"></span><span class="w-2 h-2 rounded-full bg-[#534F5C] animate-bounce" style="animation-delay:120ms"></span><span class="w-2 h-2 rounded-full bg-[#534F5C] animate-bounce" style="animation-delay:240ms"></span></div>';
    list.appendChild(wrap);
    list.scrollTop = list.scrollHeight;
    return wrap;
  }

  function renderQuick() {
    quick.innerHTML = '';
    if (loadHistory().length > 0) return;
    QUICK.forEach((q) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'text-[11px] font-bold px-3 py-1.5 rounded-full bg-[#FFF4DC] border-2 border-[#17141F] hover:bg-[#FFD44A] transition-colors cursor-pointer';
      b.textContent = q;
      b.addEventListener('click', () => { input.value = q; form.requestSubmit(); });
      quick.appendChild(b);
    });
  }

  function renderHistory() {
    list.innerHTML = '';
    const msgs = loadHistory();
    if (msgs.length === 0) {
      bubble('ai', GREETING);
    } else {
      msgs.forEach((m) => bubble(m.role, m.text));
    }
    renderQuick();
  }

  function openChat(preset?: string) {
    win.classList.remove('hidden');
    win.classList.add('flex');
    fab.classList.add('hidden');
    if (preset) {
      input.value = preset;
      form.requestSubmit();
    } else {
      input.focus();
    }
  }
  function closeChat() {
    win.classList.add('hidden');
    win.classList.remove('flex');
    fab.classList.remove('hidden');
  }

  fab.addEventListener('click', () => openChat());
  document.getElementById('ai-chat-hide')?.addEventListener('click', closeChat);
  document.getElementById('ai-chat-close')?.addEventListener('click', closeChat);
  document.getElementById('ai-chat-clear')?.addEventListener('click', () => {
    sessionStorage.removeItem(STORE_KEY);
    renderHistory();
  });
  window.addEventListener('wibu-open-ai-chat', ((e: CustomEvent<{ message?: string }>) => {
    openChat(e.detail?.message);
  }) as EventListener);

  document.getElementById('ai-chat-attach-btn')?.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', () => {
    const f = fileInput.files?.[0];
    if (!f) return;
    if (f.size > 5 * 1024 * 1024) { alert('Ảnh quá lớn (tối đa 5MB).'); fileInput.value = ''; return; }
    attached = f;
    attachImg.src = URL.createObjectURL(f);
    attachBar.classList.remove('hidden');
    attachBar.classList.add('flex');
  });
  document.getElementById('ai-chat-attach-remove')?.addEventListener('click', () => {
    attached = null;
    fileInput.value = '';
    attachBar.classList.add('hidden');
    attachBar.classList.remove('flex');
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const text = input.value.trim();
    if ((!text && !attached) || sending) return;
    sending = true;
    const file = attached;
    attached = null;
    fileInput.value = '';
    attachBar.classList.add('hidden');
    attachBar.classList.remove('flex');
    renderQuick();

    const msgs = loadHistory();
    bubble('user', text || '(đã gửi 1 ảnh)');
    msgs.push({ role: 'user', text: text || '(đã gửi 1 ảnh)', ts: Date.now() });
    saveHistory(msgs);
    input.value = '';
    const t = typingOn();

    try {
      if (file) {
        const r = await postAiVision(file, text || undefined);
        t.remove();
        if (r.ok) {
          bubble('ai', r.data.description);
          msgs.push({ role: 'ai', text: r.data.description, ts: Date.now() });
        } else {
          bubble('ai', '⚠️ ' + r.error);
        }
      } else {
        const history = msgs.slice(-10).map((m) => ({ role: m.role, text: m.text }));
        const r = await postAiChat(text, history);
        t.remove();
        if (r.ok) {
          const wrap = bubble('ai', r.data.reply);
          if (r.data.products && r.data.products.length > 0) {
            wrap.querySelector('.ai-md')?.appendChild(productCards(r.data.products));
            list.scrollTop = list.scrollHeight;
          }
          msgs.push({ role: 'ai', text: r.data.reply, ts: Date.now() });
        } else {
          bubble('ai', '⚠️ ' + r.error);
        }
      }
    } catch {
      t.remove();
      bubble('ai', '⚠️ Mất kết nối. Thử lại sau nhé.');
    } finally {
      saveHistory(msgs);
      sending = false;
    }
  });

  renderHistory();
  document.addEventListener('astro:page-load', renderHistory);
</script>
