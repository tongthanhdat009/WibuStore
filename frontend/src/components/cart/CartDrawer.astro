---
import Button from '../ui/Button.astro';
---

<!-- Cart Drawer Overlay -->
<div
  id="cart-drawer-overlay"
  class="fixed inset-0 bg-[#17141F]/60 backdrop-blur-xs z-50 opacity-0 pointer-events-none transition-opacity duration-300"
  aria-hidden="true"
>
  <!-- Slide-out panel -->
  <aside
    id="cart-drawer-panel"
    class="absolute top-0 right-0 h-full w-full max-w-md bg-white border-l-3 border-[#17141F] shadow-[-6px_0px_0px_#17141F] flex flex-col justify-between transform translate-x-full transition-transform duration-300 ease-in-out"
    role="dialog"
    aria-label="Giỏ hàng của bạn"
    aria-modal="true"
  >
    <!-- Drawer Header -->
    <div class="p-4 md:p-5 border-b-2 border-[#17141F] bg-[#FFFDF7] flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="font-display text-xl uppercase tracking-wider text-[#17141F]">
          GIỎ HÀNG
        </span>
        <span
          id="cart-drawer-count-badge"
          class="font-display text-xs bg-[#FFD44A] text-[#17141F] px-2 py-0.5 rounded border border-[#17141F]"
        >
          0 MÓN
        </span>
      </div>

      <button
        id="cart-drawer-close"
        type="button"
        class="w-8 h-8 rounded-lg border-2 border-[#17141F] bg-white hover:bg-[#FFE6ED] text-[#17141F] flex items-center justify-center font-bold shadow-[2px_2px_0px_#17141F] cursor-pointer"
        aria-label="Đóng giỏ hàng"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Free shipping progress indicator -->
    <div class="px-5 py-2.5 bg-[#FFF4DC] border-b border-[#17141F]/15 text-xs text-[#17141F] flex items-center gap-2">
      <span class="text-base">🚚</span>
      <span id="shipping-threshold-text">
        Miễn phí vận chuyển cho đơn từ <strong>1.500.000 ₫</strong>
      </span>
    </div>

    <!-- Drawer Body (Items list or Empty State) -->
    <div id="cart-drawer-items" class="flex-1 overflow-y-auto p-4 md:p-5 space-y-3">
      <!-- Populated dynamically via client JS -->
      <div id="cart-drawer-empty" class="py-12 text-center text-[#534F5C]">
        <div class="w-14 h-14 mx-auto mb-3 rounded-full bg-[#F7F5F0] border-2 border-[#17141F] flex items-center justify-center text-2xl">
          🛒
        </div>
        <p class="font-bold text-sm text-[#17141F]">Giỏ hàng của bạn đang trống</p>
        <p class="text-xs text-[#6A6572] mt-1">Hãy chọn những mô hình anime tuyệt đẹp nhé!</p>
        <div class="mt-4">
          <a
            href="/figures"
            class="inline-block text-xs font-bold text-[#D6284F] hover:underline"
          >
            Khám phá mô hình có sẵn &rarr;
          </a>
        </div>
      </div>
    </div>

    <!-- Drawer Footer (Subtotal & Actions) -->
    <div class="p-4 md:p-5 border-t-2 border-[#17141F] bg-[#FFFDF7]">
      <div class="flex items-center justify-between text-sm mb-3">
        <span class="font-bold text-[#534F5C]">Tạm tính:</span>
        <span id="cart-drawer-subtotal" class="font-sans text-xl font-black text-[#D6284F]">
          0 ₫
        </span>
      </div>

      <div class="grid grid-cols-2 gap-2.5">
        <a
          href="/cart"
          class="w-full py-2.5 px-3 rounded-xl border-2 border-[#17141F] bg-white hover:bg-[#F7F5F0] text-[#17141F] font-bold text-xs text-center shadow-[2px_2px_0px_#17141F] transition-all"
        >
          Xem giỏ hàng
        </a>
        <a
          href="/checkout"
          class="w-full py-2.5 px-3 rounded-xl border-2 border-[#17141F] bg-[#D6284F] hover:bg-[#AF1E40] text-white font-bold text-xs text-center shadow-[2px_2px_0px_#17141F] transition-all"
        >
          Thanh toán ngay
        </a>
      </div>
    </div>
  </aside>
</div>

<script>
  import { getStoredCart, updateCartQuantity, removeCartItem } from '../../lib/cart';
  import { formatVND } from '../../lib/utils';

  function initCartDrawer() {
    const overlay = document.getElementById('cart-drawer-overlay');
    const panel = document.getElementById('cart-drawer-panel');
    const closeBtn = document.getElementById('cart-drawer-close');
    const itemsContainer = document.getElementById('cart-drawer-items');
    const countBadge = document.getElementById('cart-drawer-count-badge');
    const subtotalEl = document.getElementById('cart-drawer-subtotal');

    function openDrawer() {
      if (!overlay || !panel) return;
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      overlay.classList.add('opacity-100', 'pointer-events-auto');
      panel.classList.remove('translate-x-full');
      renderDrawerItems();
    }

    function closeDrawer() {
      if (!overlay || !panel) return;
      panel.classList.add('translate-x-full');
      overlay.classList.remove('opacity-100', 'pointer-events-auto');
      overlay.classList.add('opacity-0', 'pointer-events-none');
    }

    closeBtn?.addEventListener('click', closeDrawer);
    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay) closeDrawer();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeDrawer();
    });

    // Listen to open-cart custom event
    window.addEventListener('wibu-open-cart', openDrawer);

    function renderDrawerItems() {
      if (!itemsContainer) return;
      const cart = getStoredCart();

      const totalItems = cart.reduce((acc, item) => acc + item.quantity, 0);
      const subtotal = cart.reduce((acc, item) => acc + item.price * item.quantity, 0);

      if (countBadge) countBadge.textContent = `${totalItems} MÓN`;
      if (subtotalEl) subtotalEl.textContent = formatVND(subtotal);

      if (cart.length === 0) {
        itemsContainer.innerHTML = `
          <div class="py-12 text-center text-[#534F5C]">
            <div class="w-14 h-14 mx-auto mb-3 rounded-full bg-[#F7F5F0] border-2 border-[#17141F] flex items-center justify-center text-2xl shadow-[2px_2px_0px_#17141F]">
              🛒
            </div>
            <p class="font-bold text-sm text-[#17141F]">Giỏ hàng của bạn đang trống</p>
            <p class="text-xs text-[#6A6572] mt-1">Hãy chọn những mô hình anime tuyệt đẹp nhé!</p>
            <div class="mt-4">
              <a href="/figures" class="inline-block text-xs font-bold text-[#D6284F] hover:underline">
                Khám phá mô hình có sẵn &rarr;
              </a>
            </div>
          </div>
        `;
        return;
      }

      itemsContainer.innerHTML = cart
        .map(
          (item) => `
        <div class="p-3 bg-[#F7F5F0] rounded-xl border border-[#D8D4D0] flex gap-3 relative group">
          <div class="w-16 h-16 rounded-lg overflow-hidden bg-white border border-[#17141F]/20 shrink-0">
            <img src="${item.image}" alt="${item.name}" class="w-full h-full object-cover" />
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-start justify-between gap-1">
              <h4 class="text-xs font-bold text-[#17141F] truncate leading-tight">${item.name}</h4>
              <button
                type="button"
                class="remove-cart-btn text-[#6A6572] hover:text-[#D6284F] text-xs font-bold p-0.5 cursor-pointer"
                data-id="${item.productId}"
                aria-label="Xóa"
              >
                ✕
              </button>
            </div>
            <span class="text-[10px] text-[#534F5C]">${item.series}</span>
            ${
              item.isPreOrder
                ? `<span class="inline-block text-[9px] font-bold text-[#9A5A00] bg-amber-50 px-1.5 py-0.2 rounded border border-amber-300">ĐẶT TRƯỚC</span>`
                : ''
            }
            <div class="mt-2 flex items-center justify-between">
              <span class="text-xs font-black text-[#D6284F]">${formatVND(item.price)}</span>
              <div class="flex items-center border border-[#17141F] rounded-lg bg-white overflow-hidden shadow-[1px_1px_0px_#17141F]">
                <button
                  type="button"
                  class="qty-btn px-2 py-0.5 text-xs font-bold hover:bg-[#FFE6ED] cursor-pointer"
                  data-id="${item.productId}"
                  data-action="dec"
                >-</button>
                <span class="px-2 text-xs font-bold">${item.quantity}</span>
                <button
                  type="button"
                  class="qty-btn px-2 py-0.5 text-xs font-bold hover:bg-[#FFE6ED] cursor-pointer"
                  data-id="${item.productId}"
                  data-action="inc"
                >+</button>
              </div>
            </div>
          </div>
        </div>
      `
        )
        .join('');

      // Attach button event listeners
      itemsContainer.querySelectorAll<HTMLButtonElement>('.qty-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.id!;
          const action = btn.dataset.action;
          const currentItem = cart.find((i) => i.productId === id);
          if (!currentItem) return;
          const newQty = action === 'inc' ? currentItem.quantity + 1 : currentItem.quantity - 1;
          updateCartQuantity(id, newQty);
          renderDrawerItems();
        });
      });

      itemsContainer.querySelectorAll<HTMLButtonElement>('.remove-cart-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.id!;
          removeCartItem(id);
          renderDrawerItems();
        });
      });
    }

    window.addEventListener('wibu-cart-change', renderDrawerItems);
  }

  initCartDrawer();
  document.addEventListener('astro:page-load', initCartDrawer);
</script>
