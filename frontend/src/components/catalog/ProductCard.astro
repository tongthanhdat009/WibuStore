---
import type { Product } from '../../types';
import { formatVND, getStatusBadgeInfo } from '../../lib/utils';
import StickerBadge from '../comic/StickerBadge.astro';

interface Props {
  product: Product;
  className?: string;
}

const { product, className = '' } = Astro.props;
const statusInfo = getStatusBadgeInfo(product.status);
const discountPercent =
  product.originalPrice && product.originalPrice > product.price
    ? Math.round(((product.originalPrice - product.price) / product.originalPrice) * 100)
    : null;
---

<div
  class={`product-card @container group relative bg-white rounded-2xl border border-[#D8D4D0] hover:border-[#17141F] shadow-[1px_1px_3px_rgba(0,0,0,0.05)] hover:shadow-[4px_4px_0px_#17141F] transition-all duration-200 flex flex-col justify-between overflow-hidden ${className}`}
  data-product-id={product.id}
  data-category={product.category}
  data-series={product.seriesSlug}
  data-status={product.status}
  data-price={product.price}
>
  <!-- Card Header & Media Area -->
  <div class="relative w-full aspect-square bg-[#F7F5F0] overflow-hidden p-3 flex items-center justify-center">
    <!-- Main product image -->
    <a href={`/products/${product.slug}`} class="block w-full h-full relative" aria-label={product.name}>
      <img
        src={product.images[0] ?? '/images/product-placeholder.svg'}
        alt={product.name}
        class="w-full h-full object-cover rounded-xl group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
        onerror="this.onerror=null;this.src='/images/product-placeholder.svg'"
      />
    </a>

    <!-- Top Left Badges: Status / Discount / Pre-order -->
    <div class="absolute top-3 left-3 flex flex-col gap-1.5 z-10 pointer-events-none">
      {
        product.status === 'pre_order' ? (
          <StickerBadge text="PRE-ORDER" variant="yellow" angle="none" size="sm" />
        ) : product.status === 'sold_out' ? (
          <StickerBadge text="SOLD OUT" variant="white" angle="none" size="sm" />
        ) : product.isNewArrival ? (
          <StickerBadge text="NEW" variant="mint" angle="none" size="sm" />
        ) : null
      }
      {discountPercent && (
        <span class="text-[10px] font-black bg-[#D6284F] text-white px-2 py-0.5 rounded shadow-sm border border-[#17141F]">
          -{discountPercent}%
        </span>
      )}
    </div>

    <!-- Wishlist Button Top Right -->
    <button
      type="button"
      class="wishlist-btn absolute top-3 right-3 w-8 h-8 rounded-full bg-white/90 backdrop-blur-xs border border-[#D8D4D0] hover:border-[#D6284F] text-[#534F5C] hover:text-[#D6284F] flex items-center justify-center shadow-xs transition-colors z-10 cursor-pointer"
      data-id={product.id}
      aria-label="Thêm vào danh sách yêu thích"
    >
      <svg class="w-4 h-4 heart-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
        ></path>
      </svg>
    </button>
  </div>

  <!-- Card Body Info -->
  <div class="p-3.5 sm:p-4 flex flex-col justify-between flex-1">
    <div>
      <!-- Series & Manufacturer Metadata -->
      <div class="flex items-center justify-between text-[11px] text-[#534F5C] font-semibold mb-1">
        <span class="truncate max-w-[140px] text-[#3258D7]">{product.series}</span>
        <span class="truncate text-[#6A6572]">{product.scale || product.categoryName}</span>
      </div>

      <!-- Title (Clamped to 2 lines) -->
      <h3 class="text-xs sm:text-sm font-bold text-[#17141F] line-clamp-2 group-hover:text-[#D6284F] transition-colors leading-snug">
        <a href={`/products/${product.slug}`}>
          {product.name}
        </a>
      </h3>
    </div>

    <!-- Pricing & Action Row -->
    <div class="mt-3 pt-2.5 border-t border-[#D8D4D0]/60 flex items-end justify-between gap-2">
      <div class="min-w-0">
        <div class="font-sans text-xs @min-[270px]:text-base @min-[330px]:text-lg font-black text-[#17141F] leading-none whitespace-nowrap">
          {formatVND(product.price)}
        </div>
        {product.originalPrice && (
          <div class="text-[11px] text-[#6A6572] line-through mt-0.5">
            {formatVND(product.originalPrice)}
          </div>
        )}
        {product.depositPrice && (
          <div class="text-[10px] text-[#9A5A00] font-bold">
            Cọc: {formatVND(product.depositPrice)}
          </div>
        )}
      </div>

      <!-- Quick Add / View button -->
      {
        product.status === 'sold_out' ? (
          <span class="text-[11px] font-bold text-neutral-400 bg-neutral-100 px-2.5 py-1.5 rounded-lg border border-neutral-300">
            Hết hàng
          </span>
        ) : (
          <button
            type="button"
            class="quick-add-btn shrink-0 text-xs font-bold bg-[#17141F] hover:bg-[#D6284F] text-white px-3 py-1.5 rounded-lg border border-[#17141F] shadow-[1px_1px_0px_#17141F] hover:shadow-[2px_2px_0px_#17141F] transition-all flex items-center gap-1 cursor-pointer"
            data-product-json={JSON.stringify(product)}
            title="Thêm vào giỏ hàng"
            aria-label={`Thêm ${product.name} vào giỏ hàng`}
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            <span class="hidden @min-[270px]:inline">Thêm</span>
          </button>
        )
      }
    </div>
  </div>
</div>
