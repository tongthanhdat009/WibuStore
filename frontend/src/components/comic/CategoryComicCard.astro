---
import type { CategoryInfo } from '../../types';

interface Props {
  category: CategoryInfo;
  isWide?: boolean;
}

const { category, isWide = false } = Astro.props;
---

<a
  href={`/categories/${category.slug}`}
  class={`group relative block rounded-2xl border-2 border-[#17141F] shadow-[4px_4px_0px_#17141F] hover:shadow-[7px_7px_0px_#17141F] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200 overflow-hidden bg-white ${
    isWide ? 'md:col-span-2' : ''
  }`}
  style={`background-color: ${category.accentColor}18;`}
>
  <!-- Comic decorative corner panel -->
  <div class="absolute -top-6 -right-6 w-24 h-24 rounded-full bg-white/70 border border-[#17141F]/10 pointer-events-none"></div>

  <!-- Content & figure arrangement -->
  <div class="p-5 md:p-6 flex flex-col justify-between h-full min-h-[220px] relative z-10">
    <div class="flex items-start justify-between gap-3">
      <div class="flex-1 min-w-0">
        <span class="inline-block font-display text-sm md:text-base text-[#534F5C] uppercase tracking-wider mb-1.5">
          {category.englishTitle}
        </span>
        <h3 class="w-full text-xl md:text-2xl font-black text-[#17141F] group-hover:text-[#D6284F] transition-colors leading-tight whitespace-nowrap">
          {category.name}
        </h3>
      </div>

      <!-- Badge -->
      <span class="font-display text-[11px] uppercase tracking-wider px-2 py-0.5 bg-white border-2 border-[#17141F] shadow-[2px_2px_0px_#17141F] rounded-md shrink-0">
        {category.badge}
      </span>
    </div>

    <div class="mt-4 flex items-end justify-between">
      <span class="text-xs font-bold text-[#17141F] flex items-center gap-1.5 bg-white/90 px-3 py-1.5 rounded-lg border border-[#17141F]">
        <span>Khám phá</span>
        <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </span>

      <!-- Figure thumbnail peek -->
      <div class="w-20 h-20 md:w-24 md:h-24 rounded-xl overflow-hidden border-2 border-[#17141F] shadow-[3px_3px_0px_#17141F] bg-white shrink-0">
        <img
          src={category.image}
          alt={category.name}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</a>
