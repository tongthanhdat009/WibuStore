---
import { categories } from '../../data/categories';
---

<footer class="w-full bg-[#17141F] text-white border-t-3 border-[#26212B] mt-20 pt-16 pb-12">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-white/10">
      <!-- Col 1: Brand Info -->
      <div class="lg:col-span-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-10 h-10 rounded-xl bg-[#D6284F] border-2 border-white flex items-center justify-center text-white font-display text-xl">
            W
          </div>
          <span class="font-display text-2xl tracking-wider text-white">
            WIBU<span class="text-[#FFD44A]">STORE</span>
          </span>
        </div>
        <p class="text-xs text-[#A09CA8] leading-relaxed max-w-sm mb-4">
          Cửa hàng phân phối mô hình anime, manga, action figures và Nendoroid chính hãng từ các nhà sản xuất Nhật Bản hàng đầu: Good Smile Company, Alter, eStream, Kotobukiya, MegaHouse, Bandai.
        </p>
        <div class="flex items-center gap-2">
          <span class="font-display text-xs text-[#FFD44A] uppercase tracking-wider px-2.5 py-1 rounded bg-white/5 border border-white/15">
            100% AUTHENTIC GUARANTEE
          </span>
          <span class="text-xs text-[#A09CA8]">Nói không với hàng giả / bootleg</span>
        </div>
      </div>

      <!-- Col 2: Categories -->
      <div>
        <h4 class="font-display text-sm tracking-wider uppercase text-[#FFD44A] mb-4">
          MÔ HÌNH FIGURE
        </h4>
        <ul class="space-y-2 text-xs text-[#C5C2CC]">
          {
            categories.map((c) => (
              <li>
                <a href={`/categories/${c.slug}`} class="hover:text-white transition-colors">
                  {c.name}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/pre-orders" class="text-[#FFD44A] hover:underline font-bold">
              Khu vực Pre-order
            </a>
          </li>
          <li>
            <a href="/collections" class="hover:text-white transition-colors">
              Bộ sưu tập đặc biệt
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Policies -->
      <div>
        <h4 class="font-display text-sm tracking-wider uppercase text-[#FFD44A] mb-4">
          CHÍNH SÁCH & HỖ TRỢ
        </h4>
        <ul class="space-y-2 text-xs text-[#C5C2CC]">
          <li>
            <a href="/policies/pre-order" class="hover:text-white transition-colors">
              Quy định đặt cọc Pre-order
            </a>
          </li>
          <li>
            <a href="/policies/shipping" class="hover:text-white transition-colors">
              Vận chuyển & Giao hàng
            </a>
          </li>
          <li>
            <a href="/policies/return" class="hover:text-white transition-colors">
              Đổi trả & Bảo hành gãy hỏng
            </a>
          </li>
          <li>
            <a href="/about" class="hover:text-white transition-colors">
              Về Wibu Store
            </a>
          </li>
          <li>
            <a href="/contact" class="hover:text-white transition-colors">
              Liên hệ hợp tác
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Newsletter & Social -->
      <div>
        <h4 class="font-display text-sm tracking-wider uppercase text-[#FFD44A] mb-4">
          BẢN TIN ANIME DROP
        </h4>
        <p class="text-xs text-[#A09CA8] mb-3 leading-relaxed">
          Đăng ký để nhận thông báo ngay khi các figure hot mở cổng pre-order.
        </p>
        <form class="flex flex-col gap-2" onsubmit="event.preventDefault(); alert('Cảm ơn bạn đã đăng ký nhận tin từ Wibu Store!');">
          <input
            type="email"
            placeholder="Email của bạn..."
            required
            class="w-full bg-white/10 text-white text-xs px-3.5 py-2 rounded-xl border border-white/20 focus:outline-none focus:border-[#FFD44A] placeholder-neutral-400"
          />
          <button
            type="submit"
            class="w-full bg-[#D6284F] hover:bg-[#AF1E40] text-white font-bold text-xs py-2 rounded-xl border border-white/20 shadow-[2px_2px_0px_#FFD44A] transition-all cursor-pointer"
          >
            Đăng ký nhận tin
          </button>
        </form>
      </div>
    </div>

    <!-- Bottom Bar: Payments & Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#807B8A]">
      <p>
        &copy; 2026 Wibu Store. Anime Pop & Comic Edition. Giữ toàn quyền nội dung thương mại.
      </p>

      <!-- Mock Payment Badges -->
      <div class="flex items-center gap-2">
        <span class="px-2 py-0.5 rounded bg-white/10 text-[11px] font-bold border border-white/15">VNPay</span>
        <span class="px-2 py-0.5 rounded bg-white/10 text-[11px] font-bold border border-white/15">MoMo</span>
        <span class="px-2 py-0.5 rounded bg-white/10 text-[11px] font-bold border border-white/15">Visa / Master</span>
        <span class="px-2 py-0.5 rounded bg-white/10 text-[11px] font-bold border border-white/15">COD tận nơi</span>
      </div>
    </div>
  </div>
</footer>
