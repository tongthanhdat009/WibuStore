---
// Nút mở tìm kiếm (render trong header, dialog ở global BaseLayout)
---
<button
  id="header-search-btn"
  type="button"
  class="hidden md:flex items-center gap-1.5 px-3.5 h-9 sm:h-10 rounded-xl border-2 border-[#17141F] bg-white hover:bg-[#FFD44A] text-[#17141F] text-xs font-bold shadow-[2px_2px_0px_#17141F] hover:-translate-y-0.5 transition-all cursor-pointer"
  aria-label="Mở tìm kiếm"
>
  <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
  </svg>
  <span>Tìm kiếm</span>
</button>
<button
  id="header-search-btn-mobile"
  type="button"
  class="md:hidden w-9 h-9 rounded-xl border-2 border-[#17141F] bg-[#F7F5F0] flex items-center justify-center text-[#17141F] shadow-[2px_2px_0px_#17141F] hover:bg-white transition-colors cursor-pointer"
  aria-label="Mở tìm kiếm"
>
  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
  </svg>
</button>
