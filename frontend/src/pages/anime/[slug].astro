---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import ProductGrid from '../../components/catalog/ProductGrid.astro';
import StickerBadge from '../../components/comic/StickerBadge.astro';
import { animeSeriesList as staticAnime } from '../../data/anime';
import { fetchTaxonomy, getCatalogProducts } from '../../lib/catalog';

export async function getStaticPaths() {
  const apiSeries = await fetchTaxonomy('/anime-series');
  const slugs = new Set([...apiSeries.map((s) => s.slug), ...staticAnime.map((a) => a.slug)]);
  return [...slugs].map((slug) => ({ params: { slug }, props: {} }));
}

const { slug } = Astro.params;
const apiSeries = await fetchTaxonomy('/anime-series');
const foundSeries = apiSeries.find((s) => s.slug === slug);
const fallbackAnime = staticAnime.find((a) => a.slug === slug);
const anime = {
  title: foundSeries?.name ?? fallbackAnime?.title ?? slug,
  slug,
  japaneseTitle: fallbackAnime?.japaneseTitle,
  description: fallbackAnime?.description ?? `Các mô hình thuộc series ${foundSeries?.name ?? slug}.`,
  bannerImage: fallbackAnime?.bannerImage ?? '',
  logoOnDark: fallbackAnime?.logoOnDark ?? false,
};
const { products: animeProducts } = await getCatalogProducts({ anime_series: slug, per_page: 48 });
---

<BaseLayout
  title={`Mô hình ${anime.title} chính hãng | Wibu Store`}
  description={anime.description}
>
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <Breadcrumb
      items={[
        { label: 'Anime Series', href: '/figures' },
        { label: anime.title },
      ]}
      className="mb-6"
    />

    <!-- Anime Cover Banner: logo chính thức trên chip tương phản, nền comic tối -->
    <div class="relative rounded-3xl border-3 border-[#17141F] shadow-[6px_6px_0px_#17141F] overflow-hidden mb-8 min-h-[220px] md:min-h-[260px] flex items-center p-6 md:p-10 bg-[#17141F]">
      <div class="absolute inset-0 pattern-halftone opacity-20 pointer-events-none"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-[#17141F] via-[#17141F]/40 to-transparent pointer-events-none"></div>

      <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-6 max-w-3xl">
        {anime.bannerImage && (
          <div
            class={`rounded-2xl border-2 p-4 sm:p-5 shrink-0 shadow-[3px_3px_0px_rgba(0,0,0,0.4)] ${anime.logoOnDark ? 'bg-black border-white/25' : 'bg-white border-[#17141F]'}`}
          >
            <img
              src={anime.bannerImage}
              alt={`Logo ${anime.title}`}
              class="h-20 sm:h-24 md:h-28 w-auto max-w-[220px] sm:max-w-[300px] object-contain"
            />
          </div>
        )}
        <div class="text-white">
          <div class="flex items-center gap-2 mb-2 flex-wrap">
            {anime.japaneseTitle && (
              <span class="bg-[#FFD44A] text-[#17141F] font-bold text-xs px-2.5 py-0.5 rounded border border-[#17141F]">
                {anime.japaneseTitle}
              </span>
            )}
            <StickerBadge text="OFFICIAL FRANCHISE" variant="brand" angle="left" size="sm" />
          </div>

          <h1 class="font-display text-4xl sm:text-5xl md:text-6xl uppercase tracking-tight text-white leading-none">
            {anime.title}
          </h1>

          <p class="text-xs sm:text-sm text-neutral-300 mt-2 leading-relaxed">
            {anime.description}
          </p>
        </div>
      </div>
    </div>

    <!-- Product Grid for Anime -->
    <ProductGrid
      products={animeProducts}
      emptyMessage={`Đang cập nhật thêm mô hình của series ${anime.title}. Vui lòng quay lại sau!`}
    />
  </div>
</BaseLayout>
