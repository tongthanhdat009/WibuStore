---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import ProductGrid from '../../components/catalog/ProductGrid.astro';
import StickerBadge from '../../components/comic/StickerBadge.astro';
import { categories as staticCategories } from '../../data/categories';
import { fetchTaxonomy, getCatalogProducts } from '../../lib/catalog';

export async function getStaticPaths() {
  const apiCats = await fetchTaxonomy('/categories');
  const slugs = new Set([...apiCats.map((c) => c.slug), ...staticCategories.map((c) => c.slug)]);
  return [...slugs].map((slug) => ({ params: { slug }, props: {} }));
}

const { slug } = Astro.params;
const apiCats = await fetchTaxonomy('/categories');
const found = apiCats.find((c) => c.slug === slug);
const fallback = staticCategories.find((c) => c.slug === slug);
const category = {
  name: found?.name ?? fallback?.name ?? slug,
  slug,
  description: fallback?.description ?? `Các mô hình thuộc danh mục ${found?.name ?? slug}.`,
  accentColor: fallback?.accentColor ?? '#FFD44A',
  badge: fallback?.badge ?? 'CATALOG',
  englishTitle: fallback?.englishTitle ?? 'CATEGORY',
};
const { products: categoryProducts } = await getCatalogProducts({ category: slug, per_page: 48 });
---

<BaseLayout
  title={`${category.name} chính hãng | Wibu Store`}
  description={category.description}
>
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <Breadcrumb
      items={[
        { label: 'Danh mục', href: '/figures' },
        { label: category.name },
      ]}
      className="mb-6"
    />

    <!-- Category Comic Header Banner -->
    <div
      class="p-6 md:p-8 rounded-3xl border-3 border-[#17141F] shadow-[5px_5px_0px_#17141F] mb-8 relative overflow-hidden"
      style={`background-color: ${category.accentColor}30;`}
    >
      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <StickerBadge text={category.badge} variant="yellow" angle="left" size="sm" />
            <span class="font-display text-xs tracking-wider text-[#534F5C] uppercase">
              {category.englishTitle}
            </span>
          </div>

          <h1 class="font-display text-3xl sm:text-4xl md:text-5xl text-[#17141F] uppercase tracking-tight">
            {category.name}
          </h1>

          <p class="text-xs sm:text-sm text-[#534F5C] mt-2 max-w-xl leading-relaxed">
            {category.description}
          </p>
        </div>

        <div class="flex items-center gap-3 shrink-0">
          <div class="bg-white px-4 py-2 rounded-2xl border-2 border-[#17141F] shadow-[3px_3px_0px_#17141F]">
            <span class="block text-[10px] font-bold text-[#534F5C] uppercase">Tổng mô hình</span>
            <span class="font-display text-2xl text-[#D6284F]">{categoryProducts.length}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Product Grid for Category -->
    <ProductGrid
      products={categoryProducts}
      emptyMessage={`Hiện chưa có mô hình nào thuộc danh mục ${category.name}. Vui lòng quay lại sau!`}
    />
  </div>
</BaseLayout>
