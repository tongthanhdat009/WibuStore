---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import ProductGrid from '../../components/catalog/ProductGrid.astro';
import StickerBadge from '../../components/comic/StickerBadge.astro';
import { collections as staticCollections } from '../../data/collections';
import { getProductBySlug } from '../../lib/catalog';

export async function getStaticPaths() {
  const slugs = new Set(staticCollections.map((col) => col.slug));
  try {
    const base = (import.meta.env.PUBLIC_API_URL as string | undefined) || 'http://localhost:8000';
    const res = await fetch(`${base}/api/v1/collections`, { headers: { Accept: 'application/json' } });
    if (res.ok) {
      const json = await res.json();
      for (const p of json?.data ?? []) {
        if (p?.slug) slugs.add(String(p.slug).replace(/^collection-/, ''));
      }
    }
  } catch {
  }
  return [...slugs].map((slug) => ({
    params: { slug },
    props: { collection: staticCollections.find((c) => c.slug === slug) },
  }));
}

const { slug } = Astro.params;
const staticOne = staticCollections.find((c) => c.slug === slug);

interface CollectionContent {
  title?: string;
  tagline?: string;
  description?: string;
  badge?: string;
  products?: string[];
}

let collection = staticOne
  ? { ...staticOne }
  : { slug, title: slug, tagline: '', description: '', badge: 'COLLECTION', productSlugs: [] as string[] };
let liveSlugs: string[] | null = null;
try {
  const base = (import.meta.env.PUBLIC_API_URL as string | undefined) || 'http://localhost:8000';
  const res = await fetch(`${base}/api/v1/collections/${encodeURIComponent(slug)}`, { headers: { Accept: 'application/json' } });
  if (res.ok) {
    const json = await res.json();
    const content = (json?.data ?? {}) as CollectionContent;
    collection = {
      slug,
      title: content.title ?? collection.title,
      tagline: content.tagline ?? ('tagline' in collection ? (collection as { tagline: string }).tagline : ''),
      description: content.description ?? collection.description,
      badge: content.badge ?? collection.badge,
      productSlugs: content.products ?? collection.productSlugs,
    };
    if (content.products) liveSlugs = content.products;
  }
} catch {
}
if (!staticOne && !liveSlugs) {
  throw new Error(`Collection not found: ${slug}`);
}

const { products: staticProducts } = await import('../../data/products').then((m) => ({ products: m.products }));
let collectionProducts = staticProducts.filter((p) => collection.productSlugs.includes(p.slug));
if (liveSlugs) {
  const found: typeof staticProducts = [];
  for (const s of liveSlugs.slice(0, 12)) {
    try {
      const { product } = await getProductBySlug(s);
      found.push(product);
    } catch {
    }
  }
  if (found.length > 0) collectionProducts = found;
}
---

<BaseLayout
  title={`${collection.title} | Wibu Store`}
  description={collection.description}
>
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <Breadcrumb
      items={[
        { label: 'Bộ sưu tập', href: '/collections' },
        { label: collection.title },
      ]}
      className="mb-6"
    />

    <!-- Collection Header -->
    <div class="p-6 md:p-10 rounded-3xl border-3 border-[#17141F] shadow-[5px_5px_0px_#17141F] bg-[#FFFDF7] mb-8 relative overflow-hidden">
      <div class="absolute inset-0 pattern-halftone opacity-20 pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl">
        <div class="flex items-center gap-2 mb-2">
          <StickerBadge text={collection.badge} variant="yellow" angle="left" size="sm" />
          <span class="font-display text-xs tracking-wider text-[#534F5C] uppercase">
            CURATED SERIE
          </span>
        </div>

        <h1 class="font-display text-3xl sm:text-4xl md:text-5xl text-[#17141F] uppercase leading-none">
          {collection.title}
        </h1>

        <p class="text-sm font-bold text-[#D6284F] mt-2">
          {collection.tagline}
        </p>

        <p class="text-xs sm:text-sm text-[#534F5C] mt-2 leading-relaxed">
          {collection.description}
        </p>
      </div>
    </div>

    <!-- Products in collection -->
    <ProductGrid products={collectionProducts} />
  </div>
</BaseLayout>
