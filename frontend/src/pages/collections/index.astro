---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import StickerBadge from '../../components/comic/StickerBadge.astro';
import Button from '../../components/ui/Button.astro';
import { collections as staticCollections } from '../../data/collections';
import { products as staticProducts } from '../../data/products';
import { getProductBySlug } from '../../lib/catalog';

interface ApiCollection {
  slug: string;
  title: string;
}

const staticImages = (slugs: string[]) =>
  staticProducts.filter((p) => slugs.includes(p.slug)).slice(0, 2).map((p) => p.images[0]).filter(Boolean);
let collections = staticCollections.map((c) => ({ ...c, images: staticImages(c.productSlugs) }));
try {
  const base = (import.meta.env.PUBLIC_API_URL as string | undefined) || 'http://localhost:8000';
  const res = await fetch(`${base}/api/v1/collections`, { headers: { Accept: 'application/json' } });
  if (res.ok) {
    const json = await res.json();
    const apiCols = (json?.data ?? []) as { slug: string; title: string }[];
    if (apiCols.length > 0) {
      const mapped = [];
      for (const p of apiCols) {
        const slug = String(p.slug).replace(/^collection-/, '');
        const images: string[] = [];
        try {
          const cres = await fetch(`${base}/api/v1/collections/${encodeURIComponent(slug)}`, { headers: { Accept: 'application/json' } });
          if (cres.ok) {
            const cj = await cres.json();
            for (const ps of ((cj?.data?.products ?? []) as string[]).slice(0, 2)) {
              try {
                const { product } = await getProductBySlug(ps);
                if (product.images[0]) images.push(product.images[0]);
              } catch {
              }
            }
          }
        } catch {
        }
        const fb = staticCollections.find((c) => c.slug === slug);
        mapped.push({
          slug,
          badge: 'COLLECTION',
          title: p.title,
          tagline: fb?.tagline ?? '',
          description: fb?.description ?? '',
          productSlugs: [] as string[],
          images,
        });
      }
      collections = mapped;
    }
  }
} catch {
}
---

<BaseLayout
  title="Bộ sưu tập mô hình giới hạn | Wibu Store"
  description="Các bộ sưu tập mô hình anime tuyển chọn theo arc truyện, chủ đề nghệ thuật manga pop đặc sắc."
>
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <Breadcrumb items={[{ label: 'Bộ sưu tập' }]} className="mb-6" />

    <div class="mb-10 text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 mb-2">
        <StickerBadge text="LIMITED ARCHIVE" variant="yellow" angle="left" size="sm" />
      </div>
      <h1 class="font-display text-4xl sm:text-5xl text-[#17141F] uppercase tracking-tight">
        CURATED COLLECTIONS
      </h1>
      <p class="text-xs sm:text-sm text-[#534F5C] mt-2">
        Tuyển tập mô hình được giám tuyển theo những trận chiến kinh điển và phong cách nghệ thuật manga đặc trưng
      </p>
    </div>

    <div class="space-y-8">
      {
        collections.map((col) => {
          const previewImages = (col as { images?: string[] }).images ?? [];
          return (
            <div class="rounded-3xl border-3 border-[#17141F] shadow-[6px_6px_0px_#17141F] overflow-hidden bg-white p-6 md:p-10 relative">
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
                <div class="lg:col-span-7">
                  <span class="font-display text-xs text-[#D6284F] uppercase tracking-wider block mb-1">
                    {col.badge}
                  </span>
                  <h2 class="font-display text-3xl sm:text-4xl text-[#17141F] uppercase leading-none">
                    {col.title}
                  </h2>
                  <p class="text-sm font-bold text-[#17141F] mt-2">
                    {col.tagline}
                  </p>
                  <p class="text-xs sm:text-sm text-[#534F5C] mt-2 leading-relaxed max-w-xl">
                    {col.description}
                  </p>
                  <div class="mt-6">
                    <Button href={`/collections/${col.slug}`} variant="primary" size="md">
                      <span>Xem bộ sưu tập</span>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                      </svg>
                    </Button>
                  </div>
                </div>

                <div class="lg:col-span-5 grid grid-cols-2 gap-3">
                  {previewImages.slice(0, 2).map((src) => (
                    <div class="aspect-square rounded-2xl overflow-hidden border-2 border-[#17141F] shadow-[2px_2px_0px_#17141F] bg-[#F7F5F0]">
                      <img src={src} alt={col.title} class="w-full h-full object-cover" loading="lazy" />
                    </div>
                  ))}
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</BaseLayout>
