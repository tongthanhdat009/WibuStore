---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import StickerBadge from '../../components/comic/StickerBadge.astro';
import Button from '../../components/ui/Button.astro';
import { collections as staticCollections } from '../../data/collections';
import { products as staticProducts } from '../../data/products';
import { getProductBySlug } from '../../lib/catalog';

interface ApiCollection {
  slug: string;
  title: string;
}

const staticImages = (slugs: string[]) =>
  staticProducts.filter((p) => slugs.includes(p.slug)).slice(0, 2).map((p) => p.images[0]).filter(Boolean);
let collections = staticCollections.map((c) => ({ ...c, images: staticImages(c.productSlugs) }));
try {
  const base = (import.meta.env.PUBLIC_API_URL as string | undefined) || 'http://localhost:8000';
  const res = await fetch(`${base}/api/v1/collections`, { headers: { Accept: 'application/json' } });
  if (res.ok) {
    const json = await res.json();
    const apiCols = (json?.data ?? []) as { slug: string; title: string }[];
    if (apiCols.length > 0) {
      const mapped = [];
      for (const p of apiCols) {
        const slug = String(p.slug).replace(/^collection-/, '');
        const images: string[] = [];
        try {
          const cres = await fetch(`${base}/api/v1/collections/${encodeURIComponent(slug)}`, { headers: { Accept: 'application/json' } });
          if (cres.ok) {
            const cj = await cres.json();
            for (const ps of ((cj?.data?.products ?? []) as string[]).slice(0, 2)) {
              try {
                const { product } = await getProductBySlug(ps);
                if (product.images[0]) images.push(product.images[0]);
              } catch {
              }
            }
          }
        } catch {
        }
        const fb = staticCollections.find((c) => c.slug === slug);
        mapped.push({
          slug,
          badge: 'COLLECTION',
          title: p.title,
          tagline: fb?.tagline ?? '',
          description: fb?.description ?? '',
          productSlugs: [] as string[],
          images,
        });
      }
      collections = mapped;
    }
  }
} catch {
}

// Ẩn các bộ sưu tập nội bộ (seed test) khỏi mắt khách hàng.
collections = collections.filter((c) => !/e2e|test/i.test(c.slug));

// Bảng màu comic xoay vòng cho từng bộ (API không trả accent).
const palette = [
  { accent: '#D6284F', soft: '#FFE6ED' },
  { accent: '#3258D7', soft: '#E4E9FF' },
  { accent: '#FFD44A', soft: '#FFF4DC' },
  { accent: '#147A4B', soft: '#DDF9EB' },
  { accent: '#7C3AED', soft: '#EDE9FE' },
];
const FALLBACK_DESC =
  'Tuyển tập mô hình tuyển chọn từ kho chính hãng Wibu Store — bấm xem để khám phá toàn bộ sản phẩm trong bộ.';
---

<BaseLayout
  title="Bộ sưu tập mô hình giới hạn | Wibu Store"
  description="Các bộ sưu tập mô hình anime tuyển chọn theo arc truyện, chủ đề nghệ thuật manga pop đặc sắc."
>
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <Breadcrumb items={[{ label: 'Bộ sưu tập' }]} className="mb-6" />

    <!-- Editorial masthead -->
    <div class="relative rounded-3xl border-3 border-[#17141F] shadow-[6px_6px_0px_#17141F] overflow-hidden bg-[#17141F] text-white mb-10">
      <div class="absolute inset-0 pattern-halftone opacity-20 pointer-events-none"></div>
      <div class="absolute -right-6 -bottom-10 font-display text-[26vw] sm:text-[10rem] leading-none text-white/5 select-none pointer-events-none font-black">
        {String(collections.length).padStart(2, '0')}
      </div>
      <div class="relative z-10 p-6 md:p-10 max-w-3xl">
        <div class="flex items-center gap-2 mb-3 flex-wrap">
          <StickerBadge text="LIMITED ARCHIVE" variant="yellow" angle="left" size="sm" />
          <span class="font-display text-xs tracking-wider text-white/70 uppercase">
            Tuyển chọn bởi Wibu Store • {collections.length} bộ sưu tập
          </span>
        </div>
        <h1 class="font-display text-4xl sm:text-6xl uppercase tracking-tight leading-[0.95]">
          Curated<br /><span class="text-[#FFD44A]">Collections</span>
        </h1>
        <p class="text-xs sm:text-sm text-white/70 mt-3 leading-relaxed max-w-xl">
          Tuyển tập mô hình được giám tuyển theo những trận chiến kinh điển và phong cách nghệ thuật manga đặc trưng — mỗi bộ là một chương truyện trưng bày.
        </p>
      </div>
    </div>

    <div class="space-y-10">
      {
        collections.map((col, i) => {
          const pal = palette[i % palette.length];
          const previewImages = (col as { images?: string[] }).images ?? [];
          const imgs = (previewImages.length > 0 ? previewImages : ['/images/product-placeholder.svg']).slice(0, 2);
          const flip = i % 2 === 1;
          const desc = col.description || col.tagline || FALLBACK_DESC;
          return (
            <article
              class="relative rounded-3xl border-3 border-[#17141F] shadow-[6px_6px_0px_#17141F] overflow-hidden"
              style={`background-color: ${pal.soft}`}
            >
              <div class="absolute inset-0 pattern-halftone opacity-20 pointer-events-none"></div>
              {/* Ghost volume number */}
              <span
                aria-hidden="true"
                class="absolute top-2 right-4 sm:right-8 font-display font-black text-7xl sm:text-8xl leading-none select-none pointer-events-none text-[#17141F]/10"
              >
                {String(i + 1).padStart(2, '0')}
              </span>

              <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-center p-6 md:p-10">
                {/* Text column */}
                <div class={flip ? 'lg:col-span-7 lg:order-2' : 'lg:col-span-7'}>
                  <div class="flex items-center gap-2 mb-2 flex-wrap">
                    <StickerBadge text={col.badge} variant="yellow" angle={flip ? 'right' : 'left'} size="sm" />
                    <span class="font-display text-xs tracking-wider uppercase" style={`color: ${pal.accent}`}>
                      Vol. {String(i + 1).padStart(2, '0')} — Exclusive drop
                    </span>
                  </div>
                  <h2 class="font-display text-3xl sm:text-5xl text-[#17141F] uppercase leading-[0.95] tracking-tight">
                    {col.title}
                  </h2>
                  {col.tagline && (
                    <p class="text-sm sm:text-base font-black mt-2" style={`color: ${pal.accent}`}>
                      {col.tagline}
                    </p>
                  )}
                  <p class="text-xs sm:text-sm text-[#534F5C] mt-2 leading-relaxed max-w-xl">
                    {desc}
                  </p>
                  <div class="mt-6 flex items-center gap-3 flex-wrap">
                    <Button href={`/collections/${col.slug}`} variant="primary" size="md">
                      <span>Xem bộ sưu tập</span>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                      </svg>
                    </Button>
                    <span class="font-display text-xs text-[#534F5C] uppercase tracking-wider hidden sm:inline">
                      Khám phá toàn bộ →
                    </span>
                  </div>
                </div>

                {/* Visual column: tilted polaroid frames */}
                <div class={flip ? 'lg:col-span-5 lg:order-1' : 'lg:col-span-5'}>
                  <a
                    href={`/collections/${col.slug}`}
                    class="grid grid-cols-2 gap-3 sm:gap-4 group"
                    aria-label={`Xem ${col.title}`}
                  >
                    {imgs.map((src, k) => (
                      <div
                        class={`rounded-2xl overflow-hidden border-2 border-[#17141F] bg-white p-2 pb-6 shadow-[3px_3px_0px_#17141F] transition-transform duration-300 group-hover:scale-[1.02] ${k === 0 ? 'rotate-[-2deg]' : 'rotate-[2deg] translate-y-3'}`}
                      >
                        <div class="aspect-square rounded-xl overflow-hidden bg-[#F7F5F0]">
                          <img
                            src={src}
                            alt={col.title}
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                            loading="lazy"
                          />
                        </div>
                        <p class="font-display text-[10px] uppercase tracking-wider text-[#534F5C] text-center mt-1.5 truncate">
                          {col.title}
                        </p>
                      </div>
                    ))}
                  </a>
                </div>
              </div>

              {/* Bottom accent bar */}
              <div class="h-2.5 border-t-2 border-[#17141F]" style={`background-color: ${pal.accent}`}></div>
            </article>
          );
        })
      }
    </div>
  </div>
</BaseLayout>
