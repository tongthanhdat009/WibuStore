---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
---

<BaseLayout title="Quên mật khẩu | Wibu Store" description="Nhận liên kết đặt lại mật khẩu qua email.">
  <div class="max-w-[480px] mx-auto px-4 sm:px-6 py-10">
    <Breadcrumb items={[{ label: 'Quên mật khẩu' }]} className="mb-6" />
    <div class="bg-white p-6 md:p-8 rounded-3xl border-2 border-[#17141F] shadow-[5px_5px_0px_#17141F]">
      <h1 class="font-display text-2xl text-[#17141F] uppercase tracking-tight mb-4">QUÊN MẬT KHẨU</h1>
      <div id="fp-msg" class="hidden mb-4 p-3 rounded-xl text-xs"></div>
      <form id="fp-form" class="space-y-4 text-xs">
        <div>
          <label for="fp-email" class="block font-bold text-[#17141F] mb-1">Email *</label>
          <input id="fp-email" type="email" required class="w-full bg-[#F7F5F0] focus:bg-white font-semibold px-3.5 py-2.5 rounded-xl border border-[#D8D4D0] focus:border-[#17141F] focus:outline-none" />
        </div>
        <button type="submit" class="w-full py-3.5 rounded-2xl bg-[#D6284F] text-white font-display text-base uppercase border-2 border-[#17141F] shadow-[4px_4px_0px_#17141F] cursor-pointer">Gửi liên kết</button>
      </form>
      <div class="mt-4 text-xs text-center">
        <a href="/login" class="font-bold text-[#D6284F] hover:underline">← Quay lại đăng nhập</a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { API_URL } from '../lib/api';

  document.getElementById('fp-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (document.getElementById('fp-email') as HTMLInputElement).value.trim();
    const msg = document.getElementById('fp-msg');
    try {
      const res = await fetch(`${API_URL}/api/v1/auth/forgot-password`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ email }),
      });
      if (msg) {
        msg.classList.remove('hidden');
        msg.className = res.ok
          ? 'mb-4 p-3 rounded-xl text-xs bg-[#EDF7F0] border border-[#147A4B]/30 text-[#147A4B]'
          : 'mb-4 p-3 rounded-xl text-xs bg-[#FFF0F3] border border-[#D6284F]/30 text-[#A61B3F]';
        msg.textContent = res.ok ? 'Đã gửi liên kết. Kiểm tra email của bạn.' : 'Gửi thất bại. Kiểm tra lại email.';
      }
    } catch {
      if (msg) {
        msg.classList.remove('hidden');
        msg.textContent = 'Không kết nối được máy chủ.';
      }
    }
  });
</script>
