---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComicCoverHero from '../components/comic/ComicCoverHero.astro';
import CategoryComicCard from '../components/comic/CategoryComicCard.astro';
import FeaturedCollectionBanner from '../components/comic/FeaturedCollectionBanner.astro';
import AnimeSeriesCard from '../components/comic/AnimeSeriesCard.astro';
import ProductCard from '../components/catalog/ProductCard.astro';
import VideoStory from '../components/comic/VideoStory.astro';
import Button from '../components/ui/Button.astro';
import StickerBadge from '../components/comic/StickerBadge.astro';

import { heroCampaigns } from '../data/heroCampaigns';
import { categories } from '../data/categories';
import { products as staticProducts } from '../data/products';
import { animeSeriesList } from '../data/anime';
import { collections } from '../data/collections';
import { formatVND } from '../lib/utils';
import { getCatalogProducts, getProductBySlug } from '../lib/catalog';
import { getHomeContent, findSection, isSectionEnabled } from '../lib/cms';

const { products } = await getCatalogProducts();
const homeContent = await getHomeContent();
const heroSection = findSection(homeContent, 'hero_comic');
const heroOn = isSectionEnabled(homeContent, 'hero_comic');
const preorderOn = isSectionEnabled(homeContent, 'preorder_spotlight');
const newArrivalsOn = isSectionEnabled(homeContent, 'new_arrivals');
const heroOverride =
  heroSection && heroSection.enabled !== false
    ? {
        badge: typeof heroSection.eyebrow === 'string' && heroSection.eyebrow ? heroSection.eyebrow : undefined,
        headline: typeof heroSection.headline === 'string' && heroSection.headline ? heroSection.headline : undefined,
        ctaText: typeof heroSection.cta_label === 'string' && heroSection.cta_label ? heroSection.cta_label : undefined,
        ctaLink: typeof heroSection.cta_target === 'string' && heroSection.cta_target ? heroSection.cta_target : undefined,
      }
    : null;
const heroCampaignsLive = heroCampaigns.map((c, i) =>
  i === 0 && heroOverride
    ? {
        ...c,
        badge: heroOverride.badge ?? c.badge,
        displayEnglishHeadline: heroOverride.headline ?? c.displayEnglishHeadline,
        primaryCtaText: heroOverride.ctaText ?? c.primaryCtaText,
        primaryCtaLink: heroOverride.ctaLink ?? c.primaryCtaLink,
      }
    : c,
);
const preOrderProducts = products.filter((p) => p.status === 'pre_order').slice(0, 4);
const newArrivalProducts = products.filter((p) => p.isNewArrival || p.status === 'in_stock').slice(0, 4);
const featuredCollection = collections.find((c) => c.slug === 'wano-kuni-climax') ?? collections[0];
const featuredCollectionProducts = products.filter((p) =>
  featuredCollection.productSlugs.includes(p.slug)
);
// Lấy thẳng detail Gojo để thẻ demo luôn đúng món (list trang chủ chỉ detail 24 món đầu).
// Rớt mạng build thì fallback món Gojo trong list, cuối cùng mới lấy món đầu.
const recognitionDemo = await getProductBySlug('figure-4-seed')
  .then((r) => r.product)
  .catch(() => products.find((p) => /gojo/i.test(p.name)) ?? products[0]);
const tryOnDemo =
  products.find((p) => /haori/i.test(p.name)) ??
  products.find((p) => p.slug.startsWith('cosplay')) ??
  products[0];
---

<BaseLayout
  title="Wibu Store — Anime Pop Comic Figures & Collectibles"
  description="Thế giới mô hình Anime Pop & Comic Editorial: Scale figure 1/7, Nendoroid, Action Figure, Gunpla chính hãng 100%."
>
  <!-- 1. Comic Cover Hero (CMS hero_comic override slide 0) -->
  {heroOn && <ComicCoverHero campaigns={heroCampaignsLive} />}

  <!-- 2. Quick Explore / Shop by Category -->
  <section class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 lg:pt-8 lg:pb-16">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <div class="flex items-center gap-2 mb-1.5">
          <StickerBadge text="EXPLORE" variant="brand" angle="left" size="sm" />
          <span class="font-display text-xs tracking-wider text-[#534F5C] uppercase">
            CHUYÊN MỤC SƯU TẦM
          </span>
        </div>
        <h2 class="font-display text-3xl sm:text-4xl text-[#17141F] uppercase tracking-tight">
          SHOP BY CATEGORY
        </h2>
        <p class="text-xs sm:text-sm text-[#534F5C] mt-1">
          Lựa chọn dòng mô hình phù hợp với không gian trưng bày và sở thích của bạn
        </p>
      </div>

      <a
        href="/figures"
        class="inline-flex items-center gap-1.5 font-bold text-xs text-[#D6284F] hover:underline shrink-0"
      >
        <span>Xem tất cả danh mục</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>

    <!-- Category Comic Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 md:gap-6">
      {categories.map((cat) => (
        <CategoryComicCard category={cat} />
      ))}
    </div>
  </section>

  <!-- 3. Video Story (Scrollytelling) -->
  <VideoStory />

  <!-- 4. Featured Manga Collection (Asymmetric Comic Collage) -->
  <section class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
    <FeaturedCollectionBanner
      collection={featuredCollection}
      featuredProducts={featuredCollectionProducts}
    />
  </section>

  <!-- 5. Pre-order Spotlight (CMS preorder_spotlight toggle) -->
  {preorderOn && (
  <section class="bg-[#FFF4DC] border-y-2 border-[#17141F] py-12 lg:py-18 relative overflow-hidden">
    <!-- Subtle comic halftone pattern -->
    <div class="absolute inset-0 pattern-halftone opacity-15 pointer-events-none"></div>

    <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
        <div>
          <div class="flex items-center gap-2 mb-1.5">
            <StickerBadge text="PRE-ORDER ZONE" variant="brand" angle="left" size="sm" />
            <span class="font-display text-xs tracking-wider text-[#9A5A00] uppercase font-bold">
              ĐẶT TRƯỚC SỚM — GIỮ SUẤT CHÍNH HÃNG
            </span>
          </div>
          <h2 class="font-display text-4xl sm:text-5xl text-[#17141F] uppercase tracking-tight">
            PRE-ORDER SPOTLIGHT
          </h2>
          <p class="text-sm sm:text-base text-[#534F5C] mt-1">
            Đặt cọc giữ suất từ 20% - 30%, cam kết giá không đổi và nhận hàng đúng thời hạn công bố
          </p>
        </div>

        <a
          href="/policies/pre-order"
          class="inline-flex items-center gap-1.5 text-xs font-bold text-[#9A5A00] hover:text-[#17141F] underline decoration-2 underline-offset-4"
        >
          <span>Quy định & điều khoản cọc</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
          </svg>
        </a>
      </div>

      <!-- Pre-order items with timeline and deposit tags -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
        {preOrderProducts.map((p) => (
          <div class="bg-white rounded-2xl border-2 border-[#17141F] shadow-[4px_4px_0px_#17141F] p-4 flex flex-col justify-between">
            <div>
              <div class="aspect-square rounded-xl overflow-hidden bg-[#F7F5F0] border border-[#17141F]/15 mb-3 relative group">
                <img
                  src={p.images[0]}
                  alt={p.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                />
                <span class="absolute top-2 left-2 font-display text-[10px] bg-[#FFD44A] text-[#17141F] px-2 py-0.5 rounded border border-[#17141F]">
                  DỰ KIẾN: {p.releaseDate}
                </span>
              </div>

              <span class="text-xs font-bold text-[#3258D7]">{p.series}</span>
              <h3 class="text-sm sm:text-base font-bold text-[#17141F] line-clamp-2 mt-0.5 leading-snug">
                <a href={`/products/${p.slug}`} class="hover:text-[#D6284F]">
                  {p.name}
                </a>
              </h3>
            </div>

            <div class="mt-4 pt-3 border-t border-[#D8D4D0]">
              <div class="flex items-center justify-between text-sm mb-1">
                <span class="text-[#534F5C]">Tổng giá:</span>
                <span class="font-bold text-[#17141F]">{formatVND(p.price)}</span>
              </div>
              {p.depositPrice && (
                <div class="flex items-center justify-between text-sm mb-3">
                  <span class="text-[#9A5A00] font-bold">Tiền cọc:</span>
                  <span class="font-black text-[#D6284F]">{formatVND(p.depositPrice)}</span>
                </div>
              )}

              <Button href={`/products/${p.slug}`} variant="yellow" size="sm" className="w-full">
                <span>Đặt trước ngay</span>
              </Button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- 6. Shop by Anime (Franchises) -->
  <section class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-18">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <div class="flex items-center gap-2 mb-1.5">
          <StickerBadge text="FRANCHISES" variant="mint" angle="left" size="sm" />
          <span class="font-display text-xs tracking-wider text-[#534F5C] uppercase">
            VŨ TRỤ ANIME YÊU THÍCH
          </span>
        </div>
        <h2 class="font-display text-3xl sm:text-4xl text-[#17141F] uppercase tracking-tight">
          SHOP BY ANIME
        </h2>
        <p class="text-xs sm:text-sm text-[#534F5C] mt-1">
          Khám phá trọn bộ mô hình từ các series manga & anime đình đám nhất hiện nay
        </p>
      </div>

      <a
        href="/figures"
        class="inline-flex items-center gap-1.5 font-bold text-xs text-[#D6284F] hover:underline shrink-0"
      >
        <span>Xem tất cả series</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>

    <!-- Anime Series Poster Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4">
      {animeSeriesList.map((anime) => (
        <AnimeSeriesCard anime={anime} />
      ))}
    </div>
  </section>

  <!-- 7. New Arrivals (CMS new_arrivals toggle) -->
  {newArrivalsOn && (
  <section class="bg-[#F7F5F0] border-t-2 border-[#17141F] pb-12 lg:pb-18">
    <div class="max-w-[1440px] mx-auto px-8 py-4">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
        <div>
          <div class="flex items-center gap-2 mb-1.5">
            <StickerBadge text="JUST IN" variant="brand" angle="left" size="sm" />
            <span class="font-display text-xs tracking-wider text-[#534F5C] uppercase">
              HÀNG MỚI CẬP BẾN
            </span>
          </div>
          <h2 class="font-display text-3xl sm:text-4xl text-[#17141F] uppercase tracking-tight">
            NEW ARRIVALS
          </h2>
          <p class="text-xs sm:text-sm text-[#534F5C] mt-1">
            Mô hình vừa về sẵn tại kho, đóng gói kỹ lưỡng và sẵn sàng giao hàng ngay
          </p>
        </div>

        <Button href="/figures" variant="outline" size="sm">
          <span>Xem tất cả hàng mới</span>
        </Button>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-3 sm:gap-4 lg:gap-6">
        {newArrivalProducts.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- 8. AI Image Recognition — giới thiệu Nhận Diện AI -->
  <section class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="p-6 md:p-10 rounded-3xl border-3 border-[#17141F] shadow-[6px_6px_0px_#17141F] bg-white relative overflow-hidden">
      <div class="absolute -top-10 -right-10 w-44 h-44 rounded-full bg-[#FFE6ED] border-2 border-[#17141F]/10 pointer-events-none"></div>
      <div class="absolute -bottom-12 -left-12 w-48 h-48 rounded-full bg-[#FFF4DC] border-2 border-[#17141F]/10 pointer-events-none"></div>

      <div class="relative z-10 grid lg:grid-cols-2 gap-8 items-center">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <StickerBadge text="AI VISION" variant="pink" angle="left" size="sm" />
            <span class="font-display text-xs tracking-wider text-[#534F5C] uppercase">
              CHỤP LÀ BIẾT TÊN FIGURE
            </span>
          </div>
          <h2 class="font-display text-3xl sm:text-4xl text-[#17141F] uppercase tracking-tight">
            NHẬN DIỆN AI
          </h2>
          <p class="text-xs sm:text-sm text-[#534F5C] mt-2 leading-relaxed">
            Có ảnh figure mà không biết tên? Tải ảnh lên — AI đọc tên, danh mục và đặc điểm nổi bật, rồi gợi ý ngay món tương tự đang bán trong kho.
          </p>

          <ol class="mt-5 space-y-2.5">
            <li class="flex items-center gap-3 p-2.5 rounded-2xl border-2 border-[#17141F] bg-[#FFFDF7] shadow-[3px_3px_0px_#17141F]">
              <span class="font-display text-xs bg-[#D6284F] text-white w-8 h-8 rounded-xl border-2 border-[#17141F] flex items-center justify-center shrink-0">01</span>
              <p class="text-xs text-[#17141F]"><strong>Tải ảnh lên</strong> <span class="text-[#534F5C]">— kéo thả JPG/PNG/WEBP, tối đa 5MB.</span></p>
            </li>
            <li class="flex items-center gap-3 p-2.5 rounded-2xl border-2 border-[#17141F] bg-[#FFFDF7] shadow-[3px_3px_0px_#17141F]">
              <span class="font-display text-xs bg-[#FFD44A] text-[#17141F] w-8 h-8 rounded-xl border-2 border-[#17141F] flex items-center justify-center shrink-0">02</span>
              <p class="text-xs text-[#17141F]"><strong>AI phân tích</strong> <span class="text-[#534F5C]">— tên, danh mục, đặc điểm sau 10–30 giây.</span></p>
            </li>
            <li class="flex items-center gap-3 p-2.5 rounded-2xl border-2 border-[#17141F] bg-[#FFFDF7] shadow-[3px_3px_0px_#17141F]">
              <span class="font-display text-xs bg-white text-[#17141F] w-8 h-8 rounded-xl border-2 border-[#17141F] flex items-center justify-center shrink-0">03</span>
              <p class="text-xs text-[#17141F]"><strong>Gợi ý + hỏi thêm</strong> <span class="text-[#534F5C]">— 3 món tương tự trong kho, chat hỏi tiếp.</span></p>
            </li>
          </ol>

          <div class="flex flex-wrap gap-3 mt-5">
            <Button href="/recognition" variant="primary" size="md">
              <span>Thử nhận diện ngay ✦</span>
            </Button>
            <Button href="/recognition" variant="outline" size="md">
              <span>Xem cách dùng</span>
            </Button>
          </div>
        </div>

        <!-- Visual: art AI + thẻ sản phẩm thật -->
        <div class="relative mx-auto w-full max-w-md lg:max-w-none">
          <div class="rounded-3xl overflow-hidden border-3 border-[#17141F] shadow-[6px_6px_0px_#17141F] -rotate-1 hover:rotate-0 transition-transform duration-300 bg-[#FFF4DC]">
            <img
              src="/images/ai/ai-recognition.jpg"
              alt="Minh họa AI nhận diện mô hình figure"
              class="w-full aspect-square object-cover"
              loading="lazy"
            />
          </div>
          <span class="absolute -top-3 right-6 rotate-3 font-display text-[11px] bg-[#16A34A] text-white px-3 py-1 rounded-lg border-2 border-[#17141F] shadow-[2px_2px_0px_#17141F]">
            ✓ SCAN CHUẨN 99%
          </span>
          {recognitionDemo && (
            <a
              href={`/products/${recognitionDemo.slug}`}
              class="absolute -bottom-5 left-2 sm:left-4 flex items-center gap-3 p-2.5 pr-4 rounded-2xl border-2 border-[#17141F] bg-white shadow-[4px_4px_0px_#17141F] hover:-translate-y-1 transition-transform max-w-[calc(100%-1rem)]"
            >
              <img
                src={recognitionDemo.images[0]}
                alt={recognitionDemo.name}
                class="w-14 h-14 rounded-xl object-cover border-2 border-[#17141F] shrink-0"
                loading="lazy"
              />
              <span class="min-w-0">
                <span class="block font-display text-[10px] text-[#D6284F]">AI VỪA NHẬN DIỆN ✦</span>
                <span class="block text-xs font-bold text-[#17141F] truncate">{recognitionDemo.name}</span>
                <span class="block text-xs font-black text-[#D6284F]">{formatVND(recognitionDemo.price)}</span>
              </span>
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- 9. AI Virtual Try-On — giới thiệu Thử Đồ AI -->
  <section class="bg-[#17141F] border-y-2 border-[#17141F] py-12 lg:py-16 relative overflow-hidden">
    <div class="absolute inset-0 pattern-halftone opacity-10 pointer-events-none"></div>
    <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="p-6 md:p-10 rounded-3xl border-3 border-[#FFD44A] shadow-[6px_6px_0px_#FFD44A] bg-[#FFFDF7] relative overflow-hidden">
        <div class="grid lg:grid-cols-2 gap-8 items-center">
          <!-- Visual: art AI + thẻ đồ cosplay thật -->
          <div class="relative order-2 lg:order-1 mx-auto w-full max-w-md lg:max-w-none">
            <div class="rounded-3xl overflow-hidden border-3 border-[#17141F] shadow-[6px_6px_0px_#17141F] rotate-1 hover:rotate-0 transition-transform duration-300 bg-[#17141F]">
              <img
                src="/images/ai/ai-tryon.jpg"
                alt="Minh họa tủ đồ cosplay thử đồ AI"
                class="w-full aspect-square object-cover"
                loading="lazy"
              />
            </div>
            <span class="absolute -top-3 left-6 -rotate-3 font-display text-[11px] bg-[#FFD44A] text-[#17141F] px-3 py-1 rounded-lg border-2 border-[#17141F] shadow-[2px_2px_0px_#17141F]">
              ✦ WARDROBE AI
            </span>
            {tryOnDemo && (
              <a
                href={`/products/${tryOnDemo.slug}`}
                class="absolute -bottom-5 right-2 sm:right-4 flex items-center gap-3 p-2.5 pr-4 rounded-2xl border-2 border-[#17141F] bg-white shadow-[4px_4px_0px_#17141F] hover:-translate-y-1 transition-transform max-w-[calc(100%-1rem)]"
              >
                <img
                  src={tryOnDemo.images[0]}
                  alt={tryOnDemo.name}
                  class="w-14 h-14 rounded-xl object-cover border-2 border-[#17141F] shrink-0"
                  loading="lazy"
                />
                <span class="min-w-0">
                  <span class="block font-display text-[10px] text-[#9A5A00]">ĐỒ COSPLAY TRONG KHO</span>
                  <span class="block text-xs font-bold text-[#17141F] truncate">{tryOnDemo.name}</span>
                  <span class="block text-xs font-black text-[#D6284F]">{formatVND(tryOnDemo.price)}</span>
                </span>
              </a>
            )}
          </div>

          <div class="order-1 lg:order-2">
            <div class="flex items-center gap-2 mb-2">
              <StickerBadge text="AI STUDIO" variant="yellow" angle="right" size="sm" />
              <span class="font-display text-xs tracking-wider text-[#534F5C] uppercase">
                MẶC THỬ COSPLAY ONLINE
              </span>
            </div>
            <h2 class="font-display text-3xl sm:text-4xl text-[#17141F] uppercase tracking-tight">
              THỬ ĐỒ AI
            </h2>
            <p class="text-xs sm:text-sm text-[#534F5C] mt-2 leading-relaxed">
              Phân vân bộ cosplay có hợp mình không? Upload ảnh bạn + ảnh trang phục — AI ghép thử trong 1–2 phút, ưng thì chốt đơn luôn.
            </p>

            <ol class="mt-5 space-y-2.5">
              <li class="flex items-center gap-3 p-2.5 rounded-2xl border-2 border-[#17141F] bg-white shadow-[3px_3px_0px_#17141F]">
                <span class="font-display text-xs bg-[#17141F] text-white w-8 h-8 rounded-xl border-2 border-[#17141F] flex items-center justify-center shrink-0">01</span>
                <p class="text-xs text-[#17141F]"><strong>Ảnh của bạn</strong> <span class="text-[#534F5C]">— 1 ảnh chân dung rõ mặt, đủ sáng.</span></p>
              </li>
              <li class="flex items-center gap-3 p-2.5 rounded-2xl border-2 border-[#17141F] bg-white shadow-[3px_3px_0px_#17141F]">
                <span class="font-display text-xs bg-[#FFD44A] text-[#17141F] w-8 h-8 rounded-xl border-2 border-[#17141F] flex items-center justify-center shrink-0">02</span>
                <p class="text-xs text-[#17141F]"><strong>Chọn trang phục</strong> <span class="text-[#534F5C]">— tải 1–3 ảnh đồ cosplay muốn thử.</span></p>
              </li>
              <li class="flex items-center gap-3 p-2.5 rounded-2xl border-2 border-[#17141F] bg-white shadow-[3px_3px_0px_#17141F]">
                <span class="font-display text-xs bg-[#D6284F] text-white w-8 h-8 rounded-xl border-2 border-[#17141F] flex items-center justify-center shrink-0">03</span>
                <p class="text-xs text-[#17141F]"><strong>Generate & tải về</strong> <span class="text-[#534F5C]">— so sánh Trước/Sau, tải ảnh về máy.</span></p>
              </li>
            </ol>

            <div class="flex flex-wrap gap-3 mt-5">
              <Button href="/virtual-try-on" variant="secondary" size="md">
                <span>Thử đồ ngay ✦</span>
              </Button>
              <Button href="/virtual-try-on" variant="outline" size="md">
                <span>Xem cách dùng</span>
              </Button>
            </div>
          </div>
        </div>
      </div>
