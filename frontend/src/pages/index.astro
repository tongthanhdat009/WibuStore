      <div class="absolute -top-12 -right-12 w-48 h-48 pattern-halftone opacity-25 rounded-full pointer-events-none"></div>
      <div class="absolute -bottom-10 -left-10 w-40 h-40 pattern-halftone opacity-20 rounded-full pointer-events-none"></div>

