---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import StickerBadge from '../components/comic/StickerBadge.astro';
import Button from '../components/ui/Button.astro';
import { formatVND } from '../lib/utils';
import { fetchPreorders, type ApiCampaign } from '../lib/api';
import { getProductBySlug } from '../lib/catalog';

interface CampaignCard extends ApiCampaign {
  productSlug: string;
  productName: string;
  image: string;
}

const campaigns = await fetchPreorders();
const cards: CampaignCard[] = [];
for (const c of campaigns.slice(0, 12)) {
  const slug = c.variant?.product?.slug;
  let image = '';
  let name = c.variant?.product?.name ?? c.variant?.sku ?? `Campaign #${c.id}`;
  if (slug) {
    try {
      const { product } = await getProductBySlug(slug);
      image = product.images[0] ?? '';
      name = product.name;
    } catch {
    }
  }
  cards.push({ ...c, productSlug: slug ?? '', productName: name, image });
}
---

<BaseLayout
  title="Khu vực Đặt Trước (Pre-order) Mô Hình Chính Hãng | Wibu Store"
  description="Danh sách mô hình anime đang mở đặt cọc trước. Cam kết giá không đổi và nhận hàng đúng hạn."
>
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <Breadcrumb items={[{ label: 'Khu vực Pre-order' }]} className="mb-6" />

    <!-- Hero Pre-order Banner -->
    <div class="p-6 md:p-10 rounded-3xl border-3 border-[#17141F] shadow-[6px_6px_0px_#17141F] bg-[#FFF4DC] mb-10 relative overflow-hidden">
      <div class="absolute inset-0 pattern-halftone opacity-25 pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl">
        <div class="flex items-center gap-2 mb-2">
          <StickerBadge text="PRE-ORDER ZONE" variant="brand" angle="left" size="sm" />
          <span class="font-display text-xs tracking-wider text-[#9A5A00] uppercase font-bold">
            CHÍNH SÁCH ĐẶT CỌC AN TOÀN
          </span>
        </div>

        <h1 class="font-display text-3xl sm:text-4xl md:text-5xl text-[#17141F] uppercase tracking-tight">
          PRE-ORDER ARCHIVE
        </h1>

        <p class="text-xs sm:text-sm text-[#534F5C] mt-2 leading-relaxed">
          Đặt cọc giữ suất sớm với mức giá tốt nhất từ các xưởng sản xuất Nhật Bản. Wibu Store cam kết hoàn cọc 100% nếu hãng sản xuất hủy đơn hoặc trễ lịch quá quy định.
        </p>

        <div class="mt-4 flex items-center gap-4 flex-wrap text-xs">
          <a
            href="/policies/pre-order"
            class="font-bold text-[#D6284F] hover:underline flex items-center gap-1"
          >
            <span>Đọc kỹ quy định đặt cọc & hoàn tiền</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Filter tabs -->
    <div class="flex items-center gap-2 mb-8 overflow-x-auto pb-1">
      <button
        type="button"
        class="px-4 py-2 rounded-xl border-2 border-[#17141F] bg-[#17141F] text-white text-xs font-bold shadow-[2px_2px_0px_#FFD44A]"
      >
        Đang mở đặt cọc ({cards.length})
      </button>
    </div>

    {cards.length === 0 && (
      <div class="bg-white rounded-2xl border-2 border-[#17141F] p-10 text-center text-sm text-[#534F5C]">
        Hiện chưa có chiến dịch pre-order nào đang mở. Quay lại sau nhé!
      </div>
    )}

    <!-- Pre-order grid cards with quota and deposit -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {
        cards.map((item) => {
          const percent = item.quota > 0 ? Math.round(((item.quota - item.available) / item.quota) * 100) : 0;
          return (
            <div class="bg-white rounded-2xl border-2 border-[#17141F] shadow-[4px_4px_0px_#17141F] p-4 flex flex-col justify-between">
              <div>
                <div class="aspect-square rounded-xl overflow-hidden bg-[#F7F5F0] border border-[#17141F]/15 mb-3 relative group">
                  {item.image ? (
                    <img src={item.image} alt={item.productName} class="w-full h-full object-cover group-hover:scale-105 transition-transform" loading="lazy" />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center text-xs text-[#6A6572]">Chưa có ảnh</div>
                  )}
                  <span class="absolute top-2 left-2 font-display text-[10px] bg-[#FFD44A] text-[#17141F] px-2 py-0.5 rounded border border-[#17141F]">
                    CÒN {item.available}/{item.quota} SUẤT
                  </span>
                </div>

                <h3 class="text-sm font-bold text-[#17141F] line-clamp-2 mt-0.5">
                  {item.productSlug ? (
                    <a href={`/products/${item.productSlug}`} class="hover:text-[#D6284F]">
                      {item.productName}
                    </a>
                  ) : (
                    item.productName
                  )}
                </h3>
                <div class="mt-2">
                  <div class="flex justify-between text-[11px] font-bold text-[#534F5C] mb-1">
                    <span>Đã giữ {item.quota - item.available}/{item.quota}</span>
                    <span>{percent}%</span>
                  </div>
                  <div class="w-full bg-[#EAE7E4] rounded-full h-2 overflow-hidden">
                    <div class="bg-[#D6284F] h-2 rounded-full" style={`width: ${percent}%`}></div>
                  </div>
                </div>
              </div>

              <div class="mt-4 pt-3 border-t border-[#D8D4D0]">
                <div class="flex items-center justify-between text-xs mb-1">
                  <span class="text-[#534F5C]">Giá niêm yết:</span>
                  <span class="font-bold text-[#17141F]">{formatVND(item.sale_price_per_unit_amount)}</span>
                </div>
                <div class="flex items-center justify-between text-xs mb-3">
                  <span class="text-[#9A5A00] font-bold">Tiền cọc trước:</span>
                  <span class="font-black text-[#D6284F] text-sm">{formatVND(item.deposit_per_unit_amount)}</span>
                </div>

                {item.productSlug ? (
                  <Button href={`/products/${item.productSlug}?preorder=${item.id}`} variant="yellow" size="sm" className="w-full">
                    <span>Đặt cọc ngay</span>
                  </Button>
                ) : (
                  <Button variant="yellow" size="sm" className="w-full opacity-50 pointer-events-none">
                    <span>Hết suất</span>
                  </Button>
                )}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</BaseLayout>
