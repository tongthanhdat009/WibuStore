---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import Button from '../components/ui/Button.astro';
import StickerBadge from '../components/comic/StickerBadge.astro';
---

<BaseLayout
  title="AI nhận diện mô hình | Wibu Store"
  description="Tải ảnh mô hình lên để AI nhận diện tên, danh mục và đặc điểm, kèm gợi ý sản phẩm tương tự."
>
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-10">
    <Breadcrumb items={[{ label: 'AI nhận diện mô hình' }]} className="mb-6" />

    <div class="text-center mb-8">
      <div class="flex items-center justify-center gap-2 mb-3">
        <StickerBadge text="AI VISION" variant="pink" angle="left" size="sm" />
      </div>
      <h1 class="font-display text-3xl md:text-4xl uppercase tracking-tight text-[#17141F]">
        AI IMAGE RECOGNITION
      </h1>
      <p class="text-sm font-medium text-[#534F5C] mt-2">
        Tải ảnh mô hình lên — AI sẽ nhận diện tên, danh mục và đặc điểm nổi bật.
      </p>
    </div>

    <div class="grid md:grid-cols-[45%_55%] gap-5 md:gap-6 items-start">
      <!-- Upload -->
      <section class="rounded-3xl border-[3px] border-[#17141F] shadow-[5px_5px_0px_#17141F] bg-white p-5 md:p-6">
        <h2 class="font-display text-lg tracking-wide text-[#17141F] mb-4">UPLOAD IMAGE</h2>
        <div
          id="rec-drop"
          role="button"
          tabindex="0"
          aria-label="Chọn ảnh để nhận diện"
          class="rounded-2xl border-[3px] border-dashed border-[#17141F] bg-[#F7F5F0] hover:bg-[#FFF4DC] transition-colors cursor-pointer min-h-[280px] flex flex-col items-center justify-center gap-3 p-6 text-center"
        >
          <img id="rec-preview" alt="Ảnh xem trước" class="hidden max-h-64 rounded-xl border-2 border-[#17141F] object-contain" />
          <div id="rec-placeholder">
            <div class="text-5xl mb-2">🖼️</div>
            <p class="font-bold text-sm text-[#17141F]">Kéo thả ảnh vào đây<br />hoặc nhấn để chọn</p>
            <p class="text-[11px] font-bold text-[#534F5C] mt-2">JPG, PNG, WEBP — tối đa 5MB</p>
          </div>
        </div>
        <input id="rec-file" type="file" accept="image/jpeg,image/png,image/webp" class="hidden" />
        <p id="rec-filename" class="hidden text-xs font-bold text-[#534F5C] mt-3 truncate"></p>
        <div class="flex gap-2.5 mt-4">
          <Button id="rec-submit" variant="primary" size="md" className="flex-1">Nhận diện AI ✦</Button>
          <Button id="rec-reset" variant="outline" size="md">Đổi ảnh</Button>
        </div>
      </section>

      <!-- Result -->
      <section class="rounded-3xl border-[3px] border-[#17141F] shadow-[5px_5px_0px_#17141F] bg-white p-5 md:p-6 min-h-[380px]">
        <h2 class="font-display text-lg tracking-wide text-[#17141F] mb-4">RECOGNITION RESULT</h2>

        <div id="rec-empty" class="py-10 text-center">
          <div class="text-5xl mb-3">🔍</div>
          <p class="font-bold text-sm text-[#17141F]">Chưa có kết quả</p>
          <p class="text-xs font-medium text-[#534F5C] mt-1">Upload một hình ảnh và nhấn nhận diện để bắt đầu.</p>
        </div>

        <div id="rec-loading" class="hidden py-10 text-center">
          <div class="flex justify-center gap-1.5 mb-4" aria-hidden="true">
            <span class="w-3 h-3 rounded-full bg-[#D6284F] animate-bounce"></span>
            <span class="w-3 h-3 rounded-full bg-[#FFD44A] animate-bounce" style="animation-delay:120ms"></span>
            <span class="w-3 h-3 rounded-full bg-[#17141F] animate-bounce" style="animation-delay:240ms"></span>
          </div>
          <p class="font-bold text-sm text-[#17141F]">AI đang phân tích ảnh...</p>
          <p class="text-xs font-medium text-[#534F5C] mt-1">Thường mất 10–30 giây, đừng tắt trang nhé.</p>
        </div>

        <div id="rec-error" class="hidden rounded-2xl border-2 border-[#DC2626] bg-[#FEF2F2] p-4">
          <p class="font-bold text-sm text-[#DC2626]">⚠️ Nhận diện thất bại</p>
          <p id="rec-error-msg" class="text-xs font-medium text-[#7F1D1D] mt-1"></p>
          <button id="rec-retry" type="button" class="mt-3 text-xs font-bold px-4 py-2 rounded-xl bg-[#DC2626] text-white border-2 border-[#17141F] shadow-[2px_2px_0px_#17141F] hover:brightness-110 transition-all cursor-pointer">Thử lại</button>
        </div>

        <div id="rec-success" class="hidden">
          <p class="inline-flex items-center gap-1.5 text-xs font-bold text-white bg-[#16A34A] border-2 border-[#17141F] rounded-full px-3 py-1">
            ✓ Nhận diện thành công
          </p>
          <p id="rec-desc" class="text-sm font-medium text-[#17141F] leading-relaxed mt-3 whitespace-pre-wrap"></p>
          <div class="border-t-2 border-dashed border-[#D8D4D0] my-4"></div>
          <div class="flex flex-wrap gap-2">
            <button id="rec-ask-ai" type="button" class="text-xs font-bold px-4 py-2 rounded-xl bg-[#FFD44A] border-2 border-[#17141F] shadow-[2px_2px_0px_#17141F] hover:bg-[#FACC15] transition-all cursor-pointer">💬 Hỏi AI thêm về ảnh này</button>
            <a id="rec-search" href="/figures" class="text-xs font-bold px-4 py-2 rounded-xl bg-white border-2 border-[#17141F] shadow-[2px_2px_0px_#17141F] hover:bg-[#F7F5F0] transition-all inline-flex items-center">🔎 Tìm figure tương tự</a>
          </div>
          <div id="rec-similar-wrap" class="hidden mt-5">
            <h3 class="font-display text-sm tracking-wide text-[#17141F] mb-3">KẾT QUẢ TƯƠNG TỰ</h3>
            <div id="rec-similar" class="grid grid-cols-3 gap-2.5"></div>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import { postAiVision, keywordsFromDescription } from '../lib/ai';
  import { API_URL } from '../lib/api';
  import { formatVND } from '../lib/utils';

  const drop = document.getElementById('rec-drop') as HTMLDivElement;
  const fileInput = document.getElementById('rec-file') as HTMLInputElement;
  const preview = document.getElementById('rec-preview') as HTMLImageElement;
  const placeholder = document.getElementById('rec-placeholder') as HTMLDivElement;
  const filenameEl = document.getElementById('rec-filename') as HTMLParagraphElement;
  const emptyEl = document.getElementById('rec-empty') as HTMLDivElement;
  const loadingEl = document.getElementById('rec-loading') as HTMLDivElement;
  const errorEl = document.getElementById('rec-error') as HTMLDivElement;
  const errorMsg = document.getElementById('rec-error-msg') as HTMLParagraphElement;
  const successEl = document.getElementById('rec-success') as HTMLDivElement;
  const descEl = document.getElementById('rec-desc') as HTMLParagraphElement;
  const searchLink = document.getElementById('rec-search') as HTMLAnchorElement;
  const similarWrap = document.getElementById('rec-similar-wrap') as HTMLDivElement;
  const similarGrid = document.getElementById('rec-similar') as HTMLDivElement;
  let file: File | null = null;
  let busy = false;

  function setState(s: 'empty' | 'loading' | 'error' | 'success') {
    emptyEl.classList.toggle('hidden', s !== 'empty');
    loadingEl.classList.toggle('hidden', s !== 'loading');
    errorEl.classList.toggle('hidden', s !== 'error');
    successEl.classList.toggle('hidden', s !== 'success');
  }

  function pick(f: File | undefined) {
    if (!f) return;
    if (!['image/jpeg', 'image/png', 'image/webp'].includes(f.type)) {
      errorMsg.textContent = 'Chỉ nhận file JPG, PNG, WEBP.';
      setState('error');
      return;
    }
    if (f.size > 5 * 1024 * 1024) {
      errorMsg.textContent = 'Ảnh quá lớn (tối đa 5MB).';
      setState('error');
      return;
    }
    file = f;
    preview.src = URL.createObjectURL(f);
    preview.classList.remove('hidden');
    placeholder.classList.add('hidden');
    filenameEl.textContent = f.name;
    filenameEl.classList.remove('hidden');
    setState('empty');
  }

  drop.addEventListener('click', () => fileInput.click());
  drop.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') fileInput.click(); });
  fileInput.addEventListener('change', () => pick(fileInput.files?.[0]));
  ['dragover', 'dragenter'].forEach((ev) => drop.addEventListener(ev, (e) => {
    e.preventDefault();
    drop.classList.add('bg-[#FFF4DC]');
  }));
  ['dragleave', 'drop'].forEach((ev) => drop.addEventListener(ev, (e) => {
    e.preventDefault();
    drop.classList.remove('bg-[#FFF4DC]');
  }));
  drop.addEventListener('drop', (e) => pick(e.dataTransfer?.files?.[0]));

  document.getElementById('rec-reset')?.addEventListener('click', () => {
    file = null;
    fileInput.value = '';
    preview.classList.add('hidden');
    placeholder.classList.remove('hidden');
    filenameEl.classList.add('hidden');
    setState('empty');
  });

  async function loadSimilar(desc: string) {
    const kws = keywordsFromDescription(desc);
    searchLink.href = kws.length > 0 ? `/search?q=${encodeURIComponent(kws.join(' '))}` : '/figures';
    if (kws.length === 0) return;
    try {
      const res = await fetch(`${API_URL}/api/v1/products?q=${encodeURIComponent(kws.join(' '))}&per_page=3`, {
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) return;
      const json = await res.json();
      const items = (json?.data ?? []).slice(0, 3) as { slug: string; name: string; image: string | null; price_amount: number | null }[];
      if (items.length === 0) return;
      similarGrid.innerHTML = '';
      items.forEach((p) => {
        const a = document.createElement('a');
        a.href = `/products/${p.slug}`;
        a.className = 'rounded-xl border-2 border-[#17141F] bg-[#FFFDF7] overflow-hidden hover:shadow-[3px_3px_0px_#17141F] hover:-translate-y-0.5 transition-all';
        const price = typeof p.price_amount === 'number' ? formatVND(p.price_amount) : 'Liên hệ';
        a.innerHTML = `<div class="aspect-square bg-[#F7F5F0] overflow-hidden">${
          p.image ? `<img src="${p.image}" alt="" loading="lazy" class="w-full h-full object-cover" />` : '<div class="w-full h-full flex items-center justify-center text-3xl">📦</div>'
        }</div><div class="p-2"><p class="text-[11px] font-bold text-[#17141F] leading-tight line-clamp-2">${p.name.replace(/</g, '&lt;')}</p><p class="text-[11px] font-display text-[#D6284F] mt-1">${price}</p></div>`;
        similarGrid.appendChild(a);
      });
      similarWrap.classList.remove('hidden');
    } catch { /* similar là gợi ý thêm, lỗi thì bỏ qua */ }
  }

  async function recognize() {
    if (!file || busy) return;
    busy = true;
    setState('loading');
    similarWrap.classList.add('hidden');
    const r = await postAiVision(file);
    busy = false;
    if (!r.ok) {
      errorMsg.textContent = r.error;
      setState('error');
      return;
    }
    descEl.textContent = r.data.description;
    setState('success');
    loadSimilar(r.data.description);
  }

  document.getElementById('rec-submit')?.addEventListener('click', recognize);
  document.getElementById('rec-retry')?.addEventListener('click', recognize);
  document.getElementById('rec-ask-ai')?.addEventListener('click', () => {
    const desc = descEl.textContent || '';
    sessionStorage.setItem('wibu_ai_preset', `AI vừa nhận diện ảnh của tôi: "${desc.slice(0, 300)}". Hãy tư vấn thêm.`);
    window.dispatchEvent(new CustomEvent('wibu-open-ai-chat', { detail: { message: `AI vừa nhận diện: "${desc.slice(0, 200)}". Tư vấn thêm giúp tôi.` } }));
  });

  function initRecognition() {
    setState('empty');
  }
  initRecognition();
  document.addEventListener('astro:page-load', initRecognition);
</script>
