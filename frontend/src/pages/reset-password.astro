---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
---

<BaseLayout title="Đặt lại mật khẩu | Wibu Store" description="Đặt mật khẩu mới từ liên kết email.">
  <div class="max-w-[480px] mx-auto px-4 sm:px-6 py-10">
    <Breadcrumb items={[{ label: 'Đặt lại mật khẩu' }]} className="mb-6" />
    <div class="bg-white p-6 md:p-8 rounded-3xl border-2 border-[#17141F] shadow-[5px_5px_0px_#17141F]">
      <h1 class="font-display text-2xl text-[#17141F] uppercase tracking-tight mb-4">MẬT KHẨU MỚI</h1>
      <div id="rp-msg" class="hidden mb-4 p-3 rounded-xl text-xs"></div>
      <form id="rp-form" class="space-y-4 text-xs">
        <div>
          <label for="rp-email" class="block font-bold text-[#17141F] mb-1">Email *</label>
          <input id="rp-email" type="email" required class="w-full bg-[#F7F5F0] focus:bg-white font-semibold px-3.5 py-2.5 rounded-xl border border-[#D8D4D0] focus:border-[#17141F] focus:outline-none" />
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="rp-pass" class="block font-bold text-[#17141F] mb-1">Mật khẩu mới (≥8) *</label>
            <input id="rp-pass" type="password" required minlength="8" class="w-full bg-[#F7F5F0] focus:bg-white font-semibold px-3.5 py-2.5 rounded-xl border border-[#D8D4D0] focus:border-[#17141F] focus:outline-none" />
          </div>
          <div>
            <label for="rp-pass2" class="block font-bold text-[#17141F] mb-1">Nhập lại *</label>
            <input id="rp-pass2" type="password" required minlength="8" class="w-full bg-[#F7F5F0] focus:bg-white font-semibold px-3.5 py-2.5 rounded-xl border border-[#D8D4D0] focus:border-[#17141F] focus:outline-none" />
          </div>
        </div>
        <button type="submit" class="w-full py-3.5 rounded-2xl bg-[#D6284F] text-white font-display text-base uppercase border-2 border-[#17141F] shadow-[4px_4px_0px_#17141F] cursor-pointer">Đổi mật khẩu</button>
      </form>
    </div>
  </div>
</BaseLayout>

<script>
  import { API_URL } from '../lib/api';

  document.getElementById('rp-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const v = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();
    const msg = document.getElementById('rp-msg');
    const fail = (t: string) => {
      if (msg) {
        msg.classList.remove('hidden');
        msg.className = 'mb-4 p-3 rounded-xl text-xs bg-[#FFF0F3] border border-[#D6284F]/30 text-[#A61B3F]';
        msg.textContent = t;
      }
    };
    if (v('rp-pass') !== v('rp-pass2')) return fail('Mật khẩu nhập lại không khớp.');
    const token = new URLSearchParams(window.location.search).get('token') || '';
    if (!token) return fail('Thiếu token. Mở lại liên kết trong email.');
    try {
      const res = await fetch(`${API_URL}/api/v1/auth/reset-password`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ token, email: v('rp-email'), password: v('rp-pass'), password_confirmation: v('rp-pass2') }),
      });
      if (!res.ok) return fail('Token hết hạn hoặc email sai.');
      window.location.href = '/login';
    } catch {
      fail('Không kết nối được máy chủ.');
    }
  });
</script>
