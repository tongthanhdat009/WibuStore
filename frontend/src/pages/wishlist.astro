---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import ProductGrid from '../components/catalog/ProductGrid.astro';
import StickerBadge from '../components/comic/StickerBadge.astro';
import { products } from '../data/products';
---

<BaseLayout
  title="Danh sách mô hình yêu thích | Wibu Store"
  description="Các mô hình anime và manga bạn đã lưu để theo dõi giá và tình trạng hàng."
>
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <Breadcrumb items={[{ label: 'Danh sách yêu thích' }]} className="mb-6" />

    <div class="flex items-center gap-2 mb-6">
      <StickerBadge text="WISHLIST" variant="brand" angle="left" size="sm" />
      <h1 class="font-display text-3xl sm:text-4xl text-[#17141F] uppercase tracking-tight">
        MÔ HÌNH BẠN ĐANG QUAN TÂM
      </h1>
    </div>

    <!-- Empty or Populated Container -->
    <div id="wishlist-page-container">
      <div id="wishlist-empty" class="py-16 text-center text-[#534F5C] bg-white rounded-3xl border-2 border-[#17141F] p-8 shadow-[4px_4px_0px_#17141F]">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-[#FFE6ED] border-2 border-[#17141F] flex items-center justify-center text-3xl shadow-[3px_3px_0px_#17141F]">
          ❤️
        </div>
        <h3 class="font-display text-xl text-[#17141F] uppercase">Danh sách yêu thích đang trống</h3>
        <p class="text-xs text-[#6A6572] mt-1 max-w-sm mx-auto">
          Hãy bấm vào biểu tượng trái tim ở bất kỳ mô hình nào để lưu lại danh sách này nhé!
        </p>
        <div class="mt-6">
          <a
            href="/figures"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#D6284F] text-white font-bold text-sm border-2 border-[#17141F] shadow-[3px_3px_0px_#17141F]"
          >
            <span>Khám phá mô hình</span>
            &rarr;
          </a>
        </div>
      </div>

      <div id="wishlist-grid-wrapper" class="hidden">
        <ProductGrid products={products} />
      </div>

      <div id="wishlist-server-wrapper" class="hidden">
        <div id="wishlist-server-grid" class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-3 sm:gap-4 lg:gap-6"></div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { fetchServerWishlist, getStoredWishlist, toggleWishlist } from '../lib/wishlist';
  import { formatVND } from '../lib/utils';

  function cardHTML(item: { id: string; name: string; slug: string; price_amount: number | null; image: string | null }): string {
    return `
      <div class="product-card group relative bg-white rounded-2xl border border-[#D8D4D0] hover:border-[#17141F] shadow-[1px_1px_3px_rgba(0,0,0,0.05)] hover:shadow-[4px_4px_0px_#17141F] transition-all duration-200 flex flex-col justify-between overflow-hidden">
        <div class="relative w-full aspect-square bg-[#F7F5F0] overflow-hidden p-3 flex items-center justify-center">
          <a href="/products/${item.slug}" class="block w-full h-full relative">
            ${item.image ? `<img src="${item.image}" alt="${item.name}" class="w-full h-full object-cover rounded-xl" loading="lazy" />` : '<span class="text-xs text-[#6A6572]">Chưa có ảnh</span>'}
          </a>
          <button type="button" data-wish-remove="${item.id}" class="absolute top-3 right-3 w-8 h-8 rounded-full bg-white/90 border border-[#D6284F] text-[#D6284F] flex items-center justify-center cursor-pointer" aria-label="Bỏ yêu thích">✕</button>
        </div>
        <div class="p-3">
          <a href="/products/${item.slug}" class="text-xs font-bold text-[#17141F] hover:text-[#D6284F] line-clamp-2">${item.name}</a>
          <div class="mt-1.5 font-black text-sm text-[#D6284F]">${item.price_amount != null ? formatVND(item.price_amount) : 'Liên hệ'}</div>
        </div>
      </div>`;
  }

  async function initWishlistPage() {
    const emptyEl = document.getElementById('wishlist-empty');
    const gridWrapper = document.getElementById('wishlist-grid-wrapper');
    const serverWrapper = document.getElementById('wishlist-server-wrapper');
    const serverGrid = document.getElementById('wishlist-server-grid');

    const serverItems = await fetchServerWishlist().catch(() => null);
    if (serverItems && serverItems.length > 0) {
      emptyEl?.classList.add('hidden');
      gridWrapper?.classList.add('hidden');
      if (serverGrid) {
        serverGrid.innerHTML = serverItems.map(cardHTML).join('');
      }
      serverWrapper?.classList.remove('hidden');
      serverGrid?.querySelectorAll('button[data-wish-remove]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = (btn as HTMLElement).dataset.wishRemove || '';
          toggleWishlist(id);
          (btn.closest('.product-card') as HTMLElement | null)?.remove();
          if (!serverGrid?.querySelector('.product-card')) {
            serverWrapper?.classList.add('hidden');
            emptyEl?.classList.remove('hidden');
          }
        });
      });
      return;
    }
    if (serverItems !== null) {
      emptyEl?.classList.remove('hidden');
      gridWrapper?.classList.add('hidden');
      serverWrapper?.classList.add('hidden');
      return;
    }

    const cards = document.querySelectorAll<HTMLElement>('.product-card');
    const wishlistIds = getStoredWishlist();

    if (wishlistIds.length === 0) {
      emptyEl?.classList.remove('hidden');
      gridWrapper?.classList.add('hidden');
      return;
    }

    emptyEl?.classList.add('hidden');
    gridWrapper?.classList.remove('hidden');

    let count = 0;
    cards.forEach((card) => {
      const id = card.dataset.productId || '';
      if (wishlistIds.includes(id)) {
        card.classList.remove('hidden');
        count++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (count === 0) {
      emptyEl?.classList.remove('hidden');
      gridWrapper?.classList.add('hidden');
    }
  }

  initWishlistPage();
  document.addEventListener('astro:page-load', initWishlistPage);
</script>
